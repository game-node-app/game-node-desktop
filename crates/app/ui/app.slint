import { LocalGames, LocalGameEditor, SaveProtection, ClaimConflict } from "drm-free.slint";
export { LocalGames, DiscoveryRow, BackupRow } from "drm-free.slint";
import "fonts/Roboto-Variable.ttf";
import { SyncExplanation } from "playtime-ui.slint";
import { ScrollView } from "std-widgets.slint";
import { Theme } from "theme.slint";
import { Action, Caption, Heading, Panel, Rule } from "controls.slint";
import { LibraryState } from "library-state.slint";
import { LibraryScreen, ResizeHandle, SidebarItem } from "library.slint";
import { LibraryText } from "library-text.slint";
import { AddDialog, MatchDialog } from "library-dialogs.slint";

// The sentences are exported so a test can read them in each language.
export { PlaytimeText } from "playtime-text.slint";
export { LibraryText }
// The library screens read and write these; library_ui.rs connects them to the engine.
export { LibraryState, GameItem, ProviderItem, OptionItem, CollectionItem, TargetItem, SummaryItem, MatchKind, SourceKind, StatusKind, Standing, EmptyKind, AccessKind, ViewKind, SortKind, Why, LaunchNote, SearchError, CollectionsKind, Outcome, AddError } from "library-state.slint";

export component AppWindow inherits Window {
    title: "GameNode";
    icon: @image-url("icons/gamenode.png");
    preferred-width: 1100px;
    preferred-height: 720px;
    min-width: 640px;
    min-height: 420px;
    background: Theme.color-background;
    default-font-family: "Roboto";
    default-font-size: Theme.font-size-sm;
    in property <bool> playtime-error;
    in property <bool> sync-enabled: true;
    in property <bool> store-playtime: true;
    in property <bool> sync-explanation;
    in property <bool> background-supported;
    callback sync-changed(bool);
    callback source-changed(bool);
    callback sync-dismissed();
    in property <bool> signed-in;
    in property <bool> busy;
    in property <bool> can-retry;
    in property <string> identity;
    in property <string> status;
    in property <string> storage;
    in property <bool> active-software;
    in property <bool> fallback-renderer;
    in property <string> version;
    in property <string> licenses;
    in-out property <bool> software;
    in-out property <bool> settings-open;
    private property <bool> menu-open;
    // The side navigation's width while it is being dragged (-1 otherwise).
    private property <int> nav-live: -1;
    private property <length> nav-w: (root.nav-live >= 0 ? root.nav-live : LibraryState.sidebar-width) * 1px;
    callback sign-in(int);
    callback cancel();
    callback retry();
    callback sign-out();
    callback renderer-changed(bool);
    callback quit();

    pure function localized(message: string) -> string {
        return message == "Session storage: Windows Credential Manager" ? @tr("Session storage: Windows Credential Manager") : message == "Session storage: Secret Service" ? @tr("Session storage: Secret Service") : message == "Session storage: a file readable only by your user account" ? @tr("Session storage: a file readable only by your user account") : message == "Could not open your browser. Please try again." ? @tr("Could not open your browser. Please try again.") : message == "Could not start sign-in. Please try again." ? @tr("Could not start sign-in. Please try again.") : message == "Sign-in was rejected. Please try again." ? @tr("Sign-in was rejected. Please try again.") : message == "Sign-in expired. Please try again." ? @tr("Sign-in expired. Please try again.") : message == "Sign-in cancelled." ? @tr("Sign-in cancelled.") : message == "The session was rejected. Please sign in again." ? @tr("The session was rejected. Please sign in again.") : message == "Could not connect. Your stored session is preserved; retry when online." ? @tr("Could not connect. Your stored session is preserved; retry when online.") : message == "Your stored session expired. Please sign in again." ? @tr("Your stored session expired. Please sign in again.") : message == "Could not read your session from credential storage." ? @tr("Could not read your session from credential storage.") : message == "Could not save your session. Sign-in will not survive restart." ? @tr("Could not save your session. Sign-in will not survive restart.") : message == "Signed out locally. Server sign-out could not be confirmed." ? @tr("Signed out locally. Server sign-out could not be confirmed.") : message == "Could not remove the saved credential. Check credential storage before restarting." ? @tr("Could not remove the saved credential. Check credential storage before restarting.") : message == "Complete sign-in in your browser." ? @tr("Complete sign-in in your browser.") : message;
    }


    private property <bool> licenses-open;
    in-out property <int> license-page;
    in property <int> license-page-count;
    callback license-page-changed(int);
    function open-licenses() { root.licenses-open = true; }
    forward-focus: shell-focus;
    shell-focus := FocusScope {
        enabled: !root.sync-explanation;
        x: 0px; y: 0px; width: root.width; height: root.height;
        key-pressed(event) => {
            if event.text == Key.Escape {
                root.menu-open = false;
                root.licenses-open = false;
                return accept;
            }
            return reject;
        }
    // Shell geometry follows the actual client area at every window size.
    Rectangle {
        x: 0px; y: 0px; width: root.width; height: Theme.size-topbar-height;
        background: Theme.color-chrome;
        Image { x: 20px; y: 13px; width: 72.8px; height: 28px; source: @image-url("icons/gamenode-logo.svg"); image-fit: contain; }
        Text { x: 109px; height: 54px; text: "DESKTOP"; color: Theme.color-text-dimmed; font-size: 12px; vertical-alignment: center; }
        if root.signed-in: Rectangle { x: root.width - 288px; y: 23px; width: 8px; height: 8px; border-radius: 4px; background: Theme.color-success; }
        Text { x: root.width - 264px; width: 156px; height: 54px; text: root.identity; color: Theme.color-text-default; font-weight: 500; vertical-alignment: center; overflow: elide; }
        Action { x: root.width - 96px; y: 9px; text: @tr("Menu"); width: 80px; inert: LibraryState.modal; clicked => { root.menu-open = !root.menu-open; } }
    }
    Rectangle { y: 54px; width: root.width; height: 1px; background: Theme.color-border-subtle; }
    Rectangle {
        x: 0px; y: 55px; width: root.nav-w; height: root.height - 55px;
        background: Theme.color-chrome;
        Caption { x: 16px; y: 20px; text: @tr("YOUR SPACE"); }
        Action { x: 16px; y: 56px; width: parent.width - 32px; text: @tr("Library"); selected: !root.settings-open; leading: "library"; inert: LibraryState.modal; clicked => { root.settings-open = false; } }
        if LibraryState.active: VerticalLayout {
            x: 16px; y: 104px; width: parent.width - 32px; height: max(0px, parent.height - 104px - 116px);
            spacing: 4px;
            alignment: start;
            SidebarItem {
                text: @tr("Library" => "All games"); count: LibraryState.total; selected: LibraryState.all-selected && !root.settings-open; inert: LibraryState.modal;
                clicked => { root.settings-open = false; LibraryState.set-filter(""); }
            }
            for provider in LibraryState.providers: SidebarItem {
                text: provider.name; count: provider.count; selected: provider.selected && !root.settings-open; inert: LibraryState.modal;
                clicked => { root.settings-open = false; LibraryState.set-filter(provider.id); }
            }
        }
        Rule { x: 16px; y: parent.height - 100px; width: parent.width - 32px; }
        Action { x: 16px; y: parent.height - 84px; width: parent.width - 32px; text: @tr("Settings"); selected: root.settings-open; leading: "settings"; inert: LibraryState.modal; clicked => { root.settings-open = true; } }
        Caption { x: 16px; y: parent.height - 32px; text: "GameNode · " + root.version; }
    }
    Rectangle { x: root.nav-w; y: 55px; width: 1px; height: root.height - 55px; background: Theme.color-border-subtle; }
    Rectangle {
        x: root.nav-w + 1px; y: 55px; width: root.width - root.nav-w - 1px; height: root.height - 55px;
                if !root.settings-open && LibraryState.active: LibraryScreen {
                    x: 0px; y: 0px; width: parent.width; height: parent.height - 36px - (root.status != "" ? 100px : 0px);
                    can-retry: root.can-retry; busy: root.busy;
                    retry => { root.retry(); }
                }
                if !root.settings-open && !LibraryState.active: login-view := ScrollView {
                    x: 0px; y: 0px; width: 100%; height: parent.height - 36px - (root.status != "" ? 100px : 0px);
                    VerticalLayout {
                    min-height: login-view.visible-height;
                    padding: 32px; spacing: 12px;
                    Heading { text: root.signed-in ? @tr("Library") : @tr("Welcome to GameNode"); }
                    Caption { text: root.signed-in ? @tr("A home for your games.") : @tr("Your next session starts here."); }
                    Rectangle { vertical-stretch: 1; }
                    HorizontalLayout {
                        vertical-stretch: 0;
                        Rectangle { horizontal-stretch: 1; }
                        Panel {
                            width: 360px;
                            VerticalLayout {
                                padding: 32px; spacing: 16px;
                                Rectangle {
                                    width: 64px; height: 64px; border-radius: 16px; background: Theme.color-accent-subtle;
                                    Image { x: 16px; y: 16px; width: 32px; height: 32px; source: root.signed-in ? @image-url("icons/library.svg") : @image-url("icons/arrow.svg"); colorize: Theme.color-primary; image-fit: contain; }
                                }
                                Heading { text: root.signed-in ? @tr("Your library is empty.") : @tr("Make yourself at home."); }
                                Text {
                                    text: root.signed-in ? @tr("You're all set. Your GameNode account is connected.") : @tr("Sign in with your GameNode account in your browser.");
                                    color: Theme.color-text-dimmed; wrap: word-wrap;
                                }
                                if !root.signed-in && !root.busy && !root.can-retry: VerticalLayout {
                                    spacing: 12px;
                                    Action { text: @tr("Continue with Google"); leading: "G"; primary: true; clicked => { root.sign-in(0); } }
                                    Action { text: @tr("Continue with Discord"); leading: "◉"; outlined: true; clicked => { root.sign-in(1); } }
                                    Action { text: @tr("Continue with Twitter"); leading: "X"; outlined: true; clicked => { root.sign-in(2); } }
                                }
                                if root.busy: Action { text: @tr("Cancel sign-in"); outlined: true; clicked => { root.cancel(); } }
                                if root.can-retry: Action { text: @tr("Retry connection"); primary: true; clicked => { root.retry(); } }
                                Rule {}
                                Caption { text: root.signed-in ? @tr("Connected to GameNode") : @tr("Secure sign-in in your default browser."); wrap: word-wrap; }
                            }
                        }
                        Rectangle { horizontal-stretch: 1; }
                    }
                    Rectangle { vertical-stretch: 1; }
                }
                }
                if root.settings-open: ScrollView {
                    x: 0px; y: 0px; width: 100%; height: parent.height - 36px - (root.status != "" ? 100px : 0px);
                    VerticalLayout {
                        padding: 32px; spacing: 20px;
                        Heading { text: @tr("Settings / About"); }
                        Caption { text: @tr("Make GameNode feel at home on your desktop."); wrap: word-wrap; }
                        Panel {
                            VerticalLayout {
                                padding: 20px; spacing: 16px;
                                Heading { text: @tr("Appearance & performance"); font-size: 16px; }
                                HorizontalLayout {
                                    spacing: 16px;
                                    VerticalLayout {
                                        spacing: 8px;
                                        Text { text: @tr("Software rendering"); color: Theme.color-text-default; font-weight: 500; }
                                        Caption { text: @tr("Use if you experience graphics issues. Takes effect after restarting GameNode."); wrap: word-wrap; }
                                    }
                                    Action { width: 100px; text: root.software ? @tr("On") : @tr("Off"); selected: root.software; outlined: true; clicked => { root.software = !root.software; root.renderer-changed(root.software); } }
                                }
                                Rule {}
                                Caption { text: root.fallback-renderer ? @tr("Active renderer: Software (automatic fallback)") : root.active-software ? @tr("Active renderer: Software") : @tr("Active renderer: Skia"); wrap: word-wrap; }
                            }
                        }
                        Panel {
                            VerticalLayout {
                                padding: 20px; spacing: 12px;
                                if LocalGames.supported: Action { text: @tr("DRM-free" => "Local save protection"); clicked => { LocalGames.protection-open = true; } }
                                Heading { text: @tr("Playtime & sync"); font-size: 16px; }
                                HorizontalLayout {
                                    Text { text: @tr("Sync with GameNode"); color: Theme.color-text-default; vertical-alignment: center; }
                                    Action { width: 100px; text: root.sync-enabled ? @tr("On") : @tr("Off"); selected: root.sync-enabled; outlined: true; clicked => { root.sync-changed(!root.sync-enabled); } }
                                }
                                if root.playtime-error: Caption { text: @tr("Could not sync playtime. Your local data is preserved."); wrap: word-wrap; }
                                Text { text: @tr("Playtime source"); color: Theme.color-text-default; font-weight: 500; }
                                HorizontalLayout {
                                    spacing: 12px;
                                    Action { text: @tr("Import from store"); selected: root.store-playtime; outlined: true; clicked => { root.source-changed(true); } }
                                    Action { text: @tr("Internal counter"); selected: !root.store-playtime; outlined: true; clicked => { root.source-changed(false); } }
                                }
                                Caption { text: @tr("Applies to all games on this PC. Games without a supported store counter always use the internal counter. Store and internal histories stay separate."); wrap: word-wrap; }
                            }
                        }
                        Panel {
                            VerticalLayout {
                                padding: 20px; spacing: 12px;
                                Heading { text: @tr("Session & security"); font-size: 16px; }
                                Text { text: root.localized(root.storage); color: Theme.color-text-default; wrap: word-wrap; }
                                Caption { text: @tr("Your session stays on this device, protected by your operating system."); wrap: word-wrap; }
                            }
                        }
                        Panel {
                            VerticalLayout {
                                padding: 20px; spacing: 16px;
                                HorizontalLayout {
                                    spacing: 20px;
                                    Image { source: @image-url("icons/gamenode-logo.svg"); width: 72.8px; height: 28px; image-fit: contain; }
                                    VerticalLayout {
                                        Text { text: "GameNode Desktop"; color: Theme.color-text-default; font-weight: 600; }
                                        Caption { text: @tr("Version {}", root.version) + " · GPL-3.0-only"; }
                                    }
                                    Rectangle { horizontal-stretch: 1; }
                                }
                                Rule {}
                                Caption { text: @tr("GameNode artwork: GPL-3.0-only · Roboto: SIL Open Font License 1.1 · Slint: GPLv3"); wrap: word-wrap; }
                                Action { text: @tr("Show license notices"); outlined: true; clicked => { root.open-licenses(); } }
                            }
                        }
                        Rectangle { min-height: 8px; }
                    }
                }

        if root.status != "": Rectangle {
            y: parent.height - 136px; height: 100px; width: parent.width;
            background: Theme.color-accent-subtle;
            Text { x: 20px; y: 16px; width: parent.width - 40px; text: root.localized(root.status); color: Theme.color-text-default; wrap: word-wrap; }
        }
        Rectangle {
            y: parent.height - 36px; width: parent.width; height: 36px; background: Theme.color-secondary;
            Caption { x: 20px; height: 36px; text: root.signed-in ? @tr("Connected to GameNode") : @tr("GameNode Desktop"); vertical-alignment: center; }
            Caption { x: parent.width - 80px; width: 60px; height: 36px; text: "v" + root.version; vertical-alignment: center; horizontal-alignment: right; }
        }
    }
    ResizeHandle {
        x: root.nav-w - 4px; y: 55px; height: root.height - 55px;
        label: @tr("Library" => "Resize the sidebar");
        size: root.nav-live >= 0 ? root.nav-live : LibraryState.sidebar-width;
        min-size: 160; max-size: 360; inert: LibraryState.modal;
        live(v) => { root.nav-live = v; }
        committed(v) => { root.nav-live = -1; LibraryState.sidebar-width = v; LibraryState.sidebar-width-changed(v); }
    }
    if root.menu-open: TouchArea { x: 0px; y: 0px; width: root.width; height: root.height; clicked => { root.menu-open = false; } }
    // Overlay menu leaves the content geometry stable.
    if root.menu-open: Rectangle {
        x: root.width - 252px; y: 50px; width: 236px; height: (root.signed-in || root.busy ? 208px : 164px) + (LibraryState.active ? 44px : 0px);
        background: Theme.color-raised; border-radius: 8px; border-width: 1px; border-color: Theme.color-border-subtle;
        VerticalLayout {
            padding: 8px; spacing: 8px;
            Action { text: @tr("Library"); clicked => { root.settings-open = false; root.menu-open = false; } }
            if LibraryState.active: Action { text: @tr("Library" => "Rescan"); clicked => { LibraryState.rescan(); root.menu-open = false; } }
            Action { text: @tr("Settings / About"); clicked => { root.settings-open = true; root.menu-open = false; } }
            if root.signed-in || root.busy: Action { text: @tr("Sign out"); clicked => { root.sign-out(); root.menu-open = false; } }
            Rule {}
            Action { text: @tr("Quit"); clicked => { root.quit(); } }
        }
    }
    if root.licenses-open: Rectangle {
        x: 0px; y: 0px; width: root.width; height: root.height;
        background: #161616E6;
        Rectangle {
            x: 32px; y: 32px; width: parent.width - 64px; height: parent.height - 64px;
            background: Theme.color-secondary; border-radius: 8px; border-width: 1px; border-color: Theme.color-border-subtle;
            VerticalLayout {
                padding: 20px; spacing: 16px;
                Heading { text: @tr("License notices"); }
                ScrollView {
                    vertical-stretch: 1;
                    Text { text: root.licenses; color: Theme.color-text-default; wrap: word-wrap; }
                }
                HorizontalLayout {
                    spacing: 12px;
                    Action { text: @tr("Previous"); clicked => { root.license-page-changed(max(0, root.license-page - 1)); } }
                    Caption { text: (root.license-page + 1) + " / " + root.license-page-count; vertical-alignment: center; horizontal-alignment: center; }
                    Action { text: @tr("Next"); clicked => { root.license-page-changed(min(root.license-page-count - 1, root.license-page + 1)); } }
                    Action { text: @tr("Back"); primary: true; clicked => { root.licenses-open = false; } }
                }
            }
        }
    }
    if LibraryState.match-open: MatchDialog { x: 0px; y: 0px; width: root.width; height: root.height; }
    if LibraryState.add-open: AddDialog { x: 0px; y: 0px; width: root.width; height: root.height; }
    }
    SyncExplanation {
        x: 0px; y: 0px; width: root.width; height: root.height;
        shown: root.sync-explanation;
        background-supported: root.background-supported;
        dismissed(open-settings) => { if open-settings { root.settings-open = true; } root.sync-dismissed(); shell-focus.focus(); }
    }

    if LocalGames.editing: LocalGameEditor {}

    if LocalGames.protection-open: SaveProtection { }
    if LocalGames.claim-open: ClaimConflict { }
}
