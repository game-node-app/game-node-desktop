import { Theme } from "theme.slint";

export component Caption inherits Text {
    color: Theme.color-text-dimmed;
    font-size: Theme.font-size-xs;
}
export component Heading inherits Text {
    color: Theme.color-text-default;
    font-size: Theme.font-size-xl;
    font-weight: 500;
    wrap: word-wrap;
}
export component Rule inherits Rectangle {
    height: 1px;
    background: Theme.color-border-subtle;
}
export component Panel inherits Rectangle {
    background: Theme.color-secondary;
    border-radius: Theme.radius-md;
    border-width: 1px;
    border-color: Theme.color-border-subtle;
    @children
}
export component Action inherits Rectangle {
    in property <string> text;
    in property <string> leading;
    in property <bool> primary;
    in property <bool> outlined;
    in property <bool> selected;
    // A disabled action stays visible and does nothing; the screen explains why next to it.
    in property <bool> enabled: true;
    // True while a dialog covers the screen: the action takes no focus and no clicks.
    in property <bool> inert: false;
    callback clicked();
    height: Theme.size-control-height;
    opacity: root.enabled ? 1 : 0.45;
    accessible-enabled: root.enabled && !root.inert;
    min-width: 64px;
    accessible-role: button;
    accessible-label: root.text;
    accessible-action-default => { if root.enabled { root.clicked(); } }
    forward-focus: focus;
    border-radius: Theme.radius-sm;
    border-width: focus.has-focus || root.outlined ? 1px : 0px;
    border-color: focus.has-focus ? (root.primary ? Theme.color-on-primary : Theme.color-primary) : Theme.color-border-subtle;
    background: root.primary ? (touch.pressed ? Theme.color-tertiary : touch.has-hover ? Theme.color-primary.brighter(10%) : Theme.color-primary) : root.selected ? Theme.color-accent-subtle : touch.has-hover || focus.has-focus ? Theme.color-surface : transparent;
    animate background { duration: 120ms; }
    HorizontalLayout {
        padding-left: root.primary ? 24px : 12px; padding-right: root.primary ? 24px : 12px; spacing: 10px;
        if root.leading == "library" || root.leading == "settings": Rectangle {
            width: 20px;
            height: root.height;
            Image {
                x: 0px;
                y: (parent.height - self.height) / 2;
                width: 20px;
                height: 20px;
                source: root.leading == "library" ? @image-url("icons/library.svg") : @image-url("icons/settings.svg");
                colorize: root.selected ? Theme.color-primary : Theme.color-text-default;
                image-fit: contain;
            }
        }
        if root.leading != "" && root.leading != "library" && root.leading != "settings": Text { width: 20px; text: root.leading; color: root.primary ? Theme.color-on-primary : root.selected ? Theme.color-primary : Theme.color-text-default; font-weight: 700; horizontal-alignment: center; vertical-alignment: center; }
        Text { text: root.text; color: root.primary ? Theme.color-on-primary : root.selected ? Theme.color-primary : Theme.color-text-default; font-weight: root.primary ? 700 : 600; vertical-alignment: center; horizontal-alignment: root.leading == "" ? center : left; overflow: elide; }
    }
    focus := FocusScope {
        enabled: !root.inert;
        key-pressed(event) => {
            if event.text == " " || event.text == "\n" || event.text == "\u{000d}" { if root.enabled { root.clicked(); } return accept; }
            return reject;
        }
    }
    touch := TouchArea { enabled: !root.inert; mouse-cursor: pointer; clicked => { focus.focus(); if root.enabled { root.clicked(); } } }
}
