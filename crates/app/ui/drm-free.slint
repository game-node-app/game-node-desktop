import { TextEdit } from "std-widgets.slint";
import { LibraryState } from "library-state.slint";
import { SettingsStyle } from "settings-style.slint";
import {
    SettingsPanelHeader,
    SettingsScroll,
    SettingsSection,
    SettingsCard,
    SettingsRow,
    SettingsToggle,
    SettingsButton,
    SettingsInput,
    Pill,
    InfoBox,
    Kbd,
    SettingsCloseButton,
} from "settings-controls.slint";

export struct BackupRow {
    key: string,
    label: string,
    size: string,
    destination: string,
}

export struct DiscoveryRow {
    fingerprint: string,
    title: string,
    folder: string,
    executable: string,
    targets: [string],
    picked: bool,
    resolved: bool,
}

export global LocalGames {
    in property <[DiscoveryRow]> candidates;
    in property <[DiscoveryRow]> watches;
    callback watch-remove(string);
    callback candidate-executable(string, string);
    callback watch-folder(string);
    callback watch-folder-pick();
    callback discovery-rescan();
    callback candidate-toggle(string);
    callback candidates-add(bool);
    callback ignores-reset();
    in property <string> discovered-notice;
    callback dismiss-discovered();
    in property <[string]> candidate-targets;
    in property <bool> supported;
    in property <bool> claim-open;
    in property <string> claim-title;
    callback claim-resolve(bool);
    callback claim-cancel();
    in-out property <bool> remove-open;
    in property <bool> busy;
    in property <bool> discovery-scanning;
    in property <bool> discovery-completed;
    in property <bool> discovery-incomplete;
    in property <string> discovery-error;
    in property <string> error;
    in property <string> selected-id;
    in property <string> title;
    in property <string> executable;
    in property <string> folder;
    in property <string> working-directory;
    in property <string> arguments;
    in property <string> gameplay;
    in property <string> launchers;
    in property <int> job-status;
    in property <string> match-evidence;
    in property <bool> overlapping-saves;
    in-out property <bool> editing;
    in property <int> save-status;
    in property <string> profile-title;
    in property <[string]> save-paths;
    in property <[string]> save-registry;
    in property <bool> automatic;
    in property <bool> game-automatic;
    in property <string> destination;
    in-out property <bool> protection-open;
    in property <[BackupRow]> history;
    in property <string> restore-targets;
    in property <bool> has-restore;
    callback history-load();
    callback restore-preview(string);
    callback restore-confirm();
    callback restore-cancel();
    callback backup-now();
    callback backup-settings(bool, string);
    callback game-backup-automatic(bool);
    callback custom-saves(string);
    callback saves-pick(bool);
    callback destination-pick();
    callback profile-choose(string);
    callback add();
    callback locate();
    callback remove(bool);
    callback save(string, string, string, string, string, string, string);
}

export component LocalGameEditor inherits Rectangle {
    width: 100%;
    height: 100%;
    background: SettingsStyle.overlay;

    init => {
        scope.focus();
    }

    TouchArea {
        clicked => {
            LocalGames.editing = false;
        }
    }

    Rectangle {
        x: (root.width - self.width) / 2;
        y: max(12px, (root.height - self.height) / 2);
        width: min(640px, root.width - 32px);
        height: min(620px, root.height - 24px);
        background: SettingsStyle.bg-base;
        border-radius: SettingsStyle.radius-modal;
        border-width: 1px;
        border-color: SettingsStyle.border-subtle;
        drop-shadow-color: SettingsStyle.shadow-modal-color;
        drop-shadow-offset-y: SettingsStyle.shadow-modal-offset-y;
        drop-shadow-blur: SettingsStyle.shadow-modal-blur;
        clip: true;

        TouchArea { }

        scope := FocusScope {
            width: 100%;
            height: 100%;
            focus-on-click: false;
            key-pressed(event) => {
                if event.text == Key.Escape {
                    LocalGames.editing = false;
                    return accept;
                }
                return reject;
            }

            VerticalLayout {
                width: 100%;
                height: 100%;

                SettingsPanelHeader {
                    title: @tr("DRM-free" => "Game settings");
                    description: LocalGames.title;
                    close => { LocalGames.editing = false; }
                }

                SettingsScroll {
                    vertical-stretch: 1;

                    VerticalLayout {
                        x: 0px;
                        y: 0px;
                        width: 100%;
                        height: self.preferred-height;
                        padding-top: SettingsStyle.scroll-padding-top;
                        padding-bottom: SettingsStyle.scroll-padding-bottom;
                        padding-left: 24px;
                        padding-right: 24px;
                        spacing: 16px;
                        alignment: start;

                        SettingsCard {
                            VerticalLayout {
                                padding-top: SettingsStyle.row-padding-y;
                                padding-bottom: SettingsStyle.row-padding-y;
                                padding-left: SettingsStyle.row-padding-x;
                                padding-right: SettingsStyle.row-padding-x;
                                spacing: 12px;

                                Text {
                                    text: @tr("DRM-free" => "Title");
                                    font-size: SettingsStyle.type-label;
                                    font-weight: SettingsStyle.type-label-weight;
                                    color: SettingsStyle.text-primary;
                                }
                                title := SettingsInput {
                                    text: LocalGames.title;
                                }

                                Text {
                                    text: @tr("DRM-free" => "Executable");
                                    font-size: SettingsStyle.type-label;
                                    font-weight: SettingsStyle.type-label-weight;
                                    color: SettingsStyle.text-primary;
                                }
                                executable := SettingsInput {
                                    text: LocalGames.executable;
                                }

                                if LocalGames.candidate-targets.length > 1 : VerticalLayout {
                                    spacing: 6px;
                                    Text {
                                        text: @tr("DRM-free" => "Detected executables in this folder");
                                        font-size: SettingsStyle.type-caption;
                                        color: SettingsStyle.text-secondary;
                                    }
                                    for target in LocalGames.candidate-targets : HorizontalLayout {
                                        alignment: start;
                                        SettingsButton {
                                            text: target;
                                            variant: executable.text == target ? "primary" : "secondary";
                                            clicked => {
                                                if gameplay.text == executable.text {
                                                    gameplay.text = target;
                                                }
                                                executable.text = target;
                                            }
                                        }
                                    }
                                }

                                Text {
                                    text: @tr("DRM-free" => "Game folder");
                                    font-size: SettingsStyle.type-label;
                                    font-weight: SettingsStyle.type-label-weight;
                                    color: SettingsStyle.text-primary;
                                }
                                folder := SettingsInput {
                                    text: LocalGames.folder;
                                }

                                Text {
                                    text: @tr("DRM-free" => "Working directory");
                                    font-size: SettingsStyle.type-label;
                                    font-weight: SettingsStyle.type-label-weight;
                                    color: SettingsStyle.text-primary;
                                }
                                working := SettingsInput {
                                    text: LocalGames.working-directory;
                                }

                                Text {
                                    text: @tr("DRM-free" => "Arguments");
                                    font-size: SettingsStyle.type-label;
                                    font-weight: SettingsStyle.type-label-weight;
                                    color: SettingsStyle.text-primary;
                                }
                                arguments := SettingsInput {
                                    text: LocalGames.arguments;
                                }

                                Text {
                                    text: @tr("DRM-free" => "Gameplay executables (one per line)");
                                    font-size: SettingsStyle.type-label;
                                    font-weight: SettingsStyle.type-label-weight;
                                    color: SettingsStyle.text-primary;
                                }
                                gameplay := TextEdit {
                                    text: LocalGames.gameplay;
                                    height: 56px;
                                }

                                Text {
                                    text: @tr("DRM-free" => "Launcher executables (one per line)");
                                    font-size: SettingsStyle.type-label;
                                    font-weight: SettingsStyle.type-label-weight;
                                    color: SettingsStyle.text-primary;
                                }
                                launchers := TextEdit {
                                    text: LocalGames.launchers;
                                    height: 56px;
                                }
                            }
                        }

                        HorizontalLayout {
                            spacing: 8px;
                            alignment: end;
                            SettingsButton {
                                text: @tr("DRM-free" => "Cancel");
                                variant: "secondary";
                                clicked => { LocalGames.editing = false; }
                            }
                            SettingsButton {
                                text: @tr("DRM-free" => "Save");
                                variant: "primary";
                                clicked => {
                                    LocalGames.save(title.text, executable.text, folder.text, working.text, arguments.text, gameplay.text, launchers.text);
                                    LocalGames.editing = false;
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}

export component SaveProtection inherits Rectangle {
    width: 100%;
    height: 100%;
    background: SettingsStyle.overlay;

    init => {
        scope.focus();
    }

    TouchArea {
        clicked => {
            LocalGames.protection-open = false;
        }
    }

    Rectangle {
        x: (root.width - self.width) / 2;
        y: max(12px, (root.height - self.height) / 2);
        width: min(680px, root.width - 32px);
        height: min(640px, root.height - 24px);
        background: SettingsStyle.bg-base;
        border-radius: SettingsStyle.radius-modal;
        border-width: 1px;
        border-color: SettingsStyle.border-subtle;
        drop-shadow-color: SettingsStyle.shadow-modal-color;
        drop-shadow-offset-y: SettingsStyle.shadow-modal-offset-y;
        drop-shadow-blur: SettingsStyle.shadow-modal-blur;
        clip: true;

        TouchArea { }

        scope := FocusScope {
            width: 100%;
            height: 100%;
            focus-on-click: false;
            key-pressed(event) => {
                if event.text == Key.Escape {
                    if LocalGames.has-restore {
                        LocalGames.restore-cancel();
                    } else {
                        LocalGames.protection-open = false;
                    }
                    return accept;
                }
                return reject;
            }

            VerticalLayout {
                width: 100%;
                height: 100%;

                SettingsPanelHeader {
                    title: @tr("DRM-free" => "Local save protection");
                    description: LocalGames.title != "" ? LocalGames.title : @tr("DRM-free" => "Per-game save backup and restore");
                    close => { LocalGames.protection-open = false; }
                }

                SettingsScroll {
                    vertical-stretch: 1;

                    VerticalLayout {
                        x: 0px;
                        y: 0px;
                        width: 100%;
                        height: self.preferred-height;
                        padding-top: SettingsStyle.scroll-padding-top;
                        padding-bottom: SettingsStyle.scroll-padding-bottom;
                        padding-left: 24px;
                        padding-right: 24px;
                        spacing: SettingsStyle.section-gap;
                        alignment: start;

                        if !LocalGames.automatic : InfoBox {
                            text: @tr("DRM-free" => "Global automatic backups are turned off in Settings.");
                        }

                        if LocalGames.overlapping-saves : InfoBox {
                            text: @tr("DRM-free" => "Another installation shares these saves. Backup and restore operations run one at a time.");
                        }

                        if LocalGames.error != "" : InfoBox {
                            text: LocalGames.error;
                        }

                        if LocalGames.selected-id != "" : VerticalLayout {
                            spacing: SettingsStyle.section-gap;
                            alignment: start;

                            if LocalGames.has-restore : SettingsSection {
                                title: @tr("DRM-free" => "Restore preview");

                                SettingsCard {
                                    VerticalLayout {
                                        padding-top: SettingsStyle.row-padding-y;
                                        padding-bottom: SettingsStyle.row-padding-y;
                                        padding-left: SettingsStyle.row-padding-x;
                                        padding-right: SettingsStyle.row-padding-x;
                                        spacing: 12px;

                                        Text {
                                            text: @tr("DRM-free" => "Restore replaces these targets after preserving a recovery backup:");
                                            font-size: SettingsStyle.type-label;
                                            font-weight: SettingsStyle.type-label-weight;
                                            color: SettingsStyle.warning;
                                            wrap: word-wrap;
                                        }

                                        Rectangle {
                                            background: SettingsStyle.bg-base;
                                            border-radius: SettingsStyle.radius-kbd;
                                            border-width: 1px;
                                            border-color: SettingsStyle.border-subtle;
                                            VerticalLayout {
                                                padding: 10px;
                                                Text {
                                                    text: LocalGames.restore-targets;
                                                    font-size: SettingsStyle.type-caption;
                                                    color: SettingsStyle.text-primary;
                                                    wrap: word-wrap;
                                                }
                                            }
                                        }

                                        HorizontalLayout {
                                            spacing: 8px;
                                            alignment: end;
                                            SettingsButton {
                                                text: @tr("DRM-free" => "Cancel");
                                                variant: "secondary";
                                                enabled: !LocalGames.busy;
                                                clicked => { LocalGames.restore-cancel(); }
                                            }
                                            SettingsButton {
                                                text: @tr("DRM-free" => "Confirm restore");
                                                variant: "danger";
                                                enabled: !LocalGames.busy;
                                                clicked => { LocalGames.restore-confirm(); }
                                            }
                                        }
                                    }
                                }
                            }

                            SettingsSection {
                                title: @tr("DRM-free" => "Protection status");

                                SettingsCard {
                                    VerticalLayout {
                                        SettingsRow {
                                            title: LocalGames.save-status == 0 ? @tr("DRM-free" => "No save profile configured") :
                                                   LocalGames.save-status == 3 ? @tr("DRM-free" => "Supported · No saves found yet") :
                                                   @tr("DRM-free" => "Save profile configured");
                                            description: LocalGames.profile-title != "" ? @tr("DRM-free" => "Profile: {}", LocalGames.profile-title) :
                                                         @tr("DRM-free" => "Choose a save folder or profile below to enable backups.");
                                            has-divider: true;

                                            HorizontalLayout {
                                                spacing: 8px;

                                                if LocalGames.job-status > 0 : Pill {
                                                    text: LocalGames.job-status == 1 ? @tr("DRM-free" => "Queued") :
                                                          LocalGames.job-status == 2 ? @tr("DRM-free" => "Running") :
                                                          LocalGames.job-status == 3 ? @tr("DRM-free" => "Unchanged") :
                                                          LocalGames.job-status == 4 ? @tr("DRM-free" => "Backup completed") :
                                                          LocalGames.job-status == 5 ? @tr("DRM-free" => "Partial failure") :
                                                          LocalGames.job-status == 6 ? @tr("DRM-free" => "Backup failed") :
                                                          @tr("DRM-free" => "Cancelled");
                                                    variant: (LocalGames.job-status == 3 || LocalGames.job-status == 4) ? "success" :
                                                             (LocalGames.job-status == 1 || LocalGames.job-status == 2 || LocalGames.job-status == 5 || LocalGames.job-status == 6) ? "warning" : "neutral";
                                                    y: (parent.height - self.height) / 2;
                                                }

                                                SettingsButton {
                                                    text: @tr("DRM-free" => "Backup now");
                                                    variant: "primary";
                                                    enabled: !LocalGames.busy && LocalGames.save-status != 0;
                                                    busy: LocalGames.busy;
                                                    clicked => { LocalGames.backup-now(); }
                                                }
                                            }
                                        }

                                        SettingsRow {
                                            title: @tr("DRM-free" => "Back up this game automatically");
                                            description: @tr("DRM-free" => "Creates a local snapshot after each play session.");

                                            SettingsToggle {
                                                checked: LocalGames.game-automatic;
                                                enabled: !LocalGames.busy;
                                                toggled(v) => { LocalGames.game-backup-automatic(v); }
                                            }
                                        }
                                    }
                                }
                            }

                            SettingsSection {
                                title: @tr("DRM-free" => "What is backed up");
                                description: @tr("DRM-free" => "Exact folders, files, and registry keys protected for this game.");

                                SettingsCard {
                                    VerticalLayout {
                                        SettingsRow {
                                            title: @tr("DRM-free" => "Save profile");
                                            description: LocalGames.profile-title != "" ? LocalGames.profile-title : @tr("DRM-free" => "Not configured");
                                            has-divider: true;
                                        }

                                        VerticalLayout {
                                            padding-top: SettingsStyle.row-padding-y;
                                            padding-bottom: SettingsStyle.row-padding-y;
                                            padding-left: SettingsStyle.row-padding-x;
                                            padding-right: SettingsStyle.row-padding-x;
                                            spacing: 8px;

                                            Text {
                                                text: @tr("DRM-free" => "Save folders & files");
                                                font-size: SettingsStyle.type-label;
                                                font-weight: SettingsStyle.type-label-weight;
                                                color: SettingsStyle.text-primary;
                                            }

                                            if LocalGames.save-paths.length == 0 : Text {
                                                text: LocalGames.save-status == 3 ? @tr("DRM-free" => "No save files exist on disk yet. Play the game once or choose a custom save location below.") :
                                                      @tr("DRM-free" => "No save locations resolved yet.");
                                                font-size: SettingsStyle.type-caption;
                                                color: SettingsStyle.text-secondary;
                                                wrap: word-wrap;
                                            }

                                            for path in LocalGames.save-paths : Rectangle {
                                                background: SettingsStyle.bg-base;
                                                border-radius: SettingsStyle.radius-kbd;
                                                border-width: 1px;
                                                border-color: SettingsStyle.border-subtle;
                                                VerticalLayout {
                                                    padding-left: 10px;
                                                    padding-right: 10px;
                                                    padding-top: 6px;
                                                    padding-bottom: 6px;
                                                    Text {
                                                        text: path;
                                                        font-size: SettingsStyle.type-caption;
                                                        color: SettingsStyle.text-primary;
                                                        wrap: word-wrap;
                                                    }
                                                }
                                            }
                                        }

                                        Rectangle {
                                            height: 1px;
                                            background: SettingsStyle.border-subtle;
                                        }

                                        if LocalGames.save-registry.length > 0 : VerticalLayout {
                                            padding-top: SettingsStyle.row-padding-y;
                                            padding-bottom: SettingsStyle.row-padding-y;
                                            padding-left: SettingsStyle.row-padding-x;
                                            padding-right: SettingsStyle.row-padding-x;
                                            spacing: 6px;

                                            Text {
                                                text: @tr("DRM-free" => "Registry keys");
                                                font-size: SettingsStyle.type-label;
                                                font-weight: SettingsStyle.type-label-weight;
                                                color: SettingsStyle.text-primary;
                                            }

                                            for reg in LocalGames.save-registry : Text {
                                                text: reg;
                                                font-size: SettingsStyle.type-caption;
                                                color: SettingsStyle.text-secondary;
                                                wrap: word-wrap;
                                            }
                                        }

                                        if LocalGames.save-registry.length > 0 : Rectangle {
                                            height: 1px;
                                            background: SettingsStyle.border-subtle;
                                        }

                                        SettingsRow {
                                            title: @tr("DRM-free" => "Backup destination");
                                            description: LocalGames.destination != "" ? LocalGames.destination : @tr("DRM-free" => "Default local backup folder");
                                        }
                                    }
                                }
                            }

                            SettingsSection {
                                title: @tr("DRM-free" => "Backup snapshots");
                                description: @tr("DRM-free" => "Restore a previous snapshot. A recovery backup is created before replacing files.");

                                SettingsCard {
                                    VerticalLayout {
                                        if LocalGames.history.length == 0 : SettingsRow {
                                            title: @tr("DRM-free" => "No backups recorded yet");
                                            description: @tr("DRM-free" => "Create a backup above or play the game with automatic backups enabled.");

                                            SettingsButton {
                                                text: @tr("DRM-free" => "Refresh");
                                                variant: "ghost";
                                                enabled: !LocalGames.busy;
                                                clicked => { LocalGames.history-load(); }
                                            }
                                        }

                                        for version[idx] in LocalGames.history : SettingsRow {
                                            title: version.label;
                                            description: version.destination;
                                            has-divider: idx < LocalGames.history.length - 1;

                                            HorizontalLayout {
                                                spacing: 8px;

                                                if version.size != "" : Pill {
                                                    text: version.size;
                                                    variant: "neutral";
                                                    y: (parent.height - self.height) / 2;
                                                }

                                                SettingsButton {
                                                    text: @tr("DRM-free" => "Restore…");
                                                    variant: "secondary";
                                                    enabled: !LocalGames.busy;
                                                    clicked => { LocalGames.restore-preview(version.key); }
                                                }
                                            }
                                        }
                                    }
                                }
                            }

                            SettingsSection {
                                title: @tr("DRM-free" => "Save location & profile override");
                                description: @tr("DRM-free" => "Override the save folder, file, or Ludusavi manifest profile if automatic detection does not match your setup.");

                                SettingsCard {
                                    VerticalLayout {
                                        padding-top: SettingsStyle.row-padding-y;
                                        padding-bottom: SettingsStyle.row-padding-y;
                                        padding-left: SettingsStyle.row-padding-x;
                                        padding-right: SettingsStyle.row-padding-x;
                                        spacing: 12px;

                                        HorizontalLayout {
                                            spacing: 8px;
                                            alignment: start;

                                            SettingsButton {
                                                text: @tr("DRM-free" => "Choose save folder");
                                                variant: "secondary";
                                                enabled: !LocalGames.busy;
                                                clicked => { LocalGames.saves-pick(true); }
                                            }

                                            SettingsButton {
                                                text: @tr("DRM-free" => "Choose save file");
                                                variant: "secondary";
                                                enabled: !LocalGames.busy;
                                                clicked => { LocalGames.saves-pick(false); }
                                            }
                                        }

                                        HorizontalLayout {
                                            spacing: 8px;

                                            saves := SettingsInput {
                                                horizontal-stretch: 1;
                                                placeholder: @tr("DRM-free" => "Custom save file or folder");
                                                enabled: !LocalGames.busy;
                                            }

                                            SettingsButton {
                                                text: @tr("DRM-free" => "Use this save location");
                                                variant: "secondary";
                                                enabled: !LocalGames.busy && saves.text != "";
                                                clicked => { LocalGames.custom-saves(saves.text); }
                                            }
                                        }

                                        HorizontalLayout {
                                            spacing: 8px;

                                            profile-input := SettingsInput {
                                                horizontal-stretch: 1;
                                                text: LocalGames.profile-title;
                                                placeholder: @tr("DRM-free" => "Exact save profile title");
                                                enabled: !LocalGames.busy;
                                            }

                                            SettingsButton {
                                                text: @tr("DRM-free" => "Change save profile");
                                                variant: "secondary";
                                                enabled: !LocalGames.busy && profile-input.text != "";
                                                clicked => { LocalGames.profile-choose(profile-input.text); }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}

export component ClaimConflict inherits Rectangle {
    width: 100%;
    height: 100%;
    background: SettingsStyle.overlay;

    init => {
        scope.focus();
    }

    TouchArea {
        clicked => {
            LocalGames.claim-cancel();
        }
    }

    Rectangle {
        x: (root.width - self.width) / 2;
        y: max(12px, (root.height - self.height) / 2);
        width: min(600px, root.width - 32px);
        height: min(claim-layout.preferred-height, root.height - 24px);
        background: SettingsStyle.bg-surface;
        border-radius: SettingsStyle.radius-modal;
        border-width: 1px;
        border-color: SettingsStyle.border-subtle;
        drop-shadow-color: SettingsStyle.shadow-alert-color;
        drop-shadow-offset-y: SettingsStyle.shadow-alert-offset-y;
        drop-shadow-blur: SettingsStyle.shadow-alert-blur;
        clip: true;

        TouchArea { }

        scope := FocusScope {
            width: 100%;
            height: 100%;
            focus-on-click: false;
            key-pressed(event) => {
                if event.text == Key.Escape {
                    LocalGames.claim-cancel();
                    return accept;
                }
                return reject;
            }

            claim-layout := VerticalLayout {
                SettingsPanelHeader {
                    title: @tr("DRM-free" => "This game is already tracked by a store");
                    description: LocalGames.claim-title;
                    close => { LocalGames.claim-cancel(); }
                }

                VerticalLayout {
                    padding-top: SettingsStyle.row-padding-y;
                    padding-bottom: SettingsStyle.row-padding-y;
                    padding-left: 24px;
                    padding-right: 24px;
                    spacing: 16px;

                    Text {
                        text: @tr("DRM-free" => "Use the existing entry, or transfer tracking to the DRM-free registration. Playtime will be counted once.");
                        font-size: SettingsStyle.type-body;
                        color: SettingsStyle.text-secondary;
                        wrap: word-wrap;
                    }

                    HorizontalLayout {
                        spacing: 8px;
                        alignment: end;

                        SettingsButton {
                            text: @tr("DRM-free" => "Cancel");
                            variant: "ghost";
                            clicked => { LocalGames.claim-cancel(); }
                        }

                        SettingsButton {
                            text: @tr("DRM-free" => "Use existing entry");
                            variant: "secondary";
                            clicked => { LocalGames.claim-resolve(false); }
                        }

                        SettingsButton {
                            text: @tr("DRM-free" => "Transfer tracking");
                            variant: "primary";
                            clicked => { LocalGames.claim-resolve(true); }
                        }
                    }
                }
            }
        }
    }
}

export component RemoveLocalGame inherits Rectangle {
    width: 100%;
    height: 100%;
    background: SettingsStyle.overlay;

    init => {
        scope.focus();
    }

    TouchArea {
        clicked => {
            LocalGames.remove-open = false;
        }
    }

    Rectangle {
        x: (root.width - self.width) / 2;
        y: max(12px, (root.height - self.height) / 2);
        width: min(600px, root.width - 32px);
        height: min(remove-layout.preferred-height, root.height - 24px);
        background: SettingsStyle.bg-surface;
        border-radius: SettingsStyle.radius-modal;
        border-width: 1px;
        border-color: SettingsStyle.border-subtle;
        drop-shadow-color: SettingsStyle.shadow-alert-color;
        drop-shadow-offset-y: SettingsStyle.shadow-alert-offset-y;
        drop-shadow-blur: SettingsStyle.shadow-alert-blur;
        clip: true;

        TouchArea { }

        scope := FocusScope {
            width: 100%;
            height: 100%;
            focus-on-click: false;
            key-pressed(event) => {
                if event.text == Key.Escape {
                    LocalGames.remove-open = false;
                    return accept;
                }
                return reject;
            }

            remove-layout := VerticalLayout {
                SettingsPanelHeader {
                    title: @tr("DRM-free" => "Remove from library");
                    description: LibraryState.detail-title != "" ? LibraryState.detail-title : LocalGames.title;
                    close => { LocalGames.remove-open = false; }
                }

                VerticalLayout {
                    padding-top: SettingsStyle.row-padding-y;
                    padding-bottom: SettingsStyle.row-padding-y;
                    padding-left: 24px;
                    padding-right: 24px;
                    spacing: 12px;

                    Text {
                        text: @tr("DRM-free" => "Game files and local save backups will not be deleted from your computer.");
                        font-size: SettingsStyle.type-body;
                        color: SettingsStyle.text-secondary;
                        wrap: word-wrap;
                    }

                    Text {
                        text: @tr("DRM-free" => "Choose whether this entry can be imported again on future scans or should be ignored.");
                        font-size: SettingsStyle.type-body;
                        color: SettingsStyle.text-secondary;
                        wrap: word-wrap;
                    }

                    HorizontalLayout {
                        padding-top: 4px;
                        spacing: 8px;
                        alignment: end;

                        SettingsButton {
                            text: @tr("DRM-free" => "Cancel");
                            variant: "ghost";
                            clicked => { LocalGames.remove-open = false; }
                        }

                        SettingsButton {
                            text: @tr("DRM-free" => "Remove only");
                            variant: "secondary";
                            enabled: !LocalGames.busy;
                            clicked => {
                                LocalGames.remove-open = false;
                                LocalGames.remove(true);
                            }
                        }

                        SettingsButton {
                            text: @tr("DRM-free" => "Remove and don't import again");
                            variant: "danger";
                            enabled: !LocalGames.busy;
                            clicked => {
                                LocalGames.remove-open = false;
                                LocalGames.remove(false);
                            }
                        }
                    }
                }
            }
        }
    }
}
