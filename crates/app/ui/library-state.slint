import { SettingsState } from "settings-state.slint";

export enum MatchKind { matched, ambiguous, unmatched, no-game }
export enum SourceKind { none, chosen, automatic }
export enum StatusKind { unknown, playing, finished, planned, dropped, ongoing }
export enum Standing { not-checked, checking, in-library, not-in-library, unavailable }
export enum EmptyKind { none, no-games, nothing-matches }
export enum AccessKind { unverified, offline, verified }
export enum ViewKind { grid, list }
export enum SortKind { title, provider, match-status }

// Why an action is unavailable; `available` means it is not.
export enum Why {
    available,
    running,
    nothing-selected,
    multiple-selected,
    no-launch-rule,
    no-install-rule,
    missing-field,
    needs-verified-session,
    offline,
    not-matched,
    no-matched-games,
    checking-membership,
    membership-unavailable,
    already-in-library,
}

// The last Play or Install of the selected game.
export enum LaunchNote { none, opening-play, opening-install, no-handler, failed, incomplete, unsupported }

export enum SearchError { none, blocked, rejected, failed }
export enum CollectionsKind { loading, failed, loaded }
export enum Outcome { added, already-present, skipped, failed }
export enum AddError { none, rejected, failed }

export struct GameItem {
    playtime-known: bool,
    playtime-hours: int,
    playtime-minutes: int,
    playtime-seconds: int,
    running: bool,
    key: string,
    title: string,
    provider: string,
    cover: image,
    has-cover: bool,
    kind: MatchKind,
    selected: bool,
    focused: bool,
}

export struct ProviderItem {
    id: string,
    name: string,
    count: int,
    selected: bool,
    failed: bool,
}

// A game offered by the match dialog. `id` is the GameNode game id as text.
export struct OptionItem {
    id: string,
    name: string,
    year: string,
    cover: image,
    has-cover: bool,
    current: bool,
}

export struct CollectionItem {
    id: string,
    name: string,
    picked: bool,
    forces: StatusKind,
}

export struct TargetItem {
    title: string,
    matched: bool,
}

export struct SummaryItem {
    title: string,
    outcome: Outcome,
    status: StatusKind,
}

export global LibraryState {
    // --- the list ---
    // False while no account is set: the screen is not shown.
    in-out property <bool> active;
    in-out property <[GameItem]> items;
    in-out property <int> focused-index: -1;
    in-out property <ViewKind> view: ViewKind.grid;
    in-out property <[ProviderItem]> providers;
    in-out property <bool> all-selected: true;
    in-out property <int> total;
    in-out property <string> search;
    in-out property <SortKind> sort: SortKind.title;
    in-out property <bool> descending;
    in-out property <bool> scanning;
    // Names of the stores whose last scan failed, joined for display.
    in-out property <string> failed-stores;
    in-out property <AccessKind> access: AccessKind.unverified;
    in-out property <EmptyKind> empty: EmptyKind.none;
    // Names of the stores that were looked at, joined for display.
    in-out property <string> stores;

    // --- pane sizes (logical pixels) ---
    in-out property <int> sidebar-width: 220;
    in-out property <int> detail-width: 340;
    in-out property <bool> detail-open: true;

    // --- the selection ---
    in-out property <int> selected-count;
    in-out property <Why> play-why;
    in-out property <Why> install-why;
    in-out property <Why> match-why;
    in-out property <Why> add-why;
    // Set when `add-why` is `already-in-library` and GameNode reported the status.
    in-out property <StatusKind> add-existing-status;
    in-out property <bool> change-match;

    // --- the detail of a single selected game ---
    in-out property <bool> detail-playtime-known;
    in-out property <int> detail-playtime-hours;
    in-out property <int> detail-playtime-minutes;
    in-out property <int> detail-playtime-seconds;
    in-out property <bool> detail-playtime-from-store;
    in-out property <bool> detail-running;
    in-out property <bool> detail-valid;
    in-out property <string> detail-title;
    in-out property <string> detail-detected;
    in-out property <string> detail-matched;
    in-out property <string> detail-provider;
    in-out property <string> detail-dir;
    in-out property <string> detail-year;
    in-out property <MatchKind> detail-kind;
    in-out property <SourceKind> detail-source;
    in-out property <Standing> detail-standing;
    in-out property <StatusKind> detail-standing-status;
    in-out property <image> detail-cover;
    in-out property <bool> detail-has-cover;
    in-out property <LaunchNote> launch-note;

    // --- the match dialog ---
    in-out property <bool> match-open;
    in-out property <string> match-detected;
    in-out property <string> match-provider;
    in-out property <string> match-query;
    in-out property <bool> match-searching;
    in-out property <[OptionItem]> match-candidates;
    in-out property <[OptionItem]> match-results;
    in-out property <bool> match-no-results;
    in-out property <SearchError> match-error;
    in-out property <Why> match-blocked: Why.available;
    in-out property <bool> match-can-clear;

    // --- the Add to GameNode dialog ---
    in-out property <bool> edit-existing;
    in-out property <bool> add-editing;
    in-out property <bool> add-open;
    in-out property <[TargetItem]> add-targets;
    in-out property <StatusKind> add-status: StatusKind.playing;
    in-out property <StatusKind> add-applied-status: StatusKind.playing;
    // Name of the collection whose default status applies; empty when none does.
    in-out property <string> add-applied-from;
    in-out property <CollectionsKind> add-collections-kind: CollectionsKind.loading;
    in-out property <[CollectionItem]> add-collections;
    in-out property <bool> add-running;
    in-out property <int> add-done;
    in-out property <int> add-total;
    in-out property <AddError> add-error: AddError.none;
    in-out property <bool> add-can-confirm;
    in-out property <Why> add-blocked: Why.available;
    in-out property <bool> add-has-summary;
    in-out property <[SummaryItem]> add-summary;
    in-out property <int> add-summary-added;
    in-out property <int> add-summary-present;
    in-out property <int> add-summary-skipped;
    in-out property <int> add-summary-failed;

    // True while a dialog is open: the screen behind it takes no focus.
    out property <bool> modal: match-open || add-open || SettingsState.open;

    // --- commands ---
    callback select(string, bool, bool);          // key, ctrl, shift
    callback move(int, bool);                     // direction (0 up, 1 down, 2 left, 3 right, 4 home, 5 end), extend
    callback open-details();
    callback play();
    callback install();
    callback open-match();
    callback open-add();
    callback rescan();
    callback set-view(ViewKind);
    callback set-filter(string);                  // provider id; empty for all games
    callback set-search(string);
    callback set-sort(SortKind, bool);            // key, descending
    callback set-columns(int);
    callback sidebar-width-changed(int);
    callback detail-width-changed(int);
    callback set-detail-open(bool);
    callback dismiss-launch();
    callback refresh-membership();

    callback close-match();
    callback match-query-edited(string);
    callback match-search();
    callback pick-match(string);                  // game id
    callback mark-no-game();
    callback clear-match();

    callback close-add();
    callback add-set-status(StatusKind);
    callback add-toggle-collection(string);
    callback add-retry-collections();
    callback add-confirm();
}
