// Every sentence the library screens show, in one place. Each is a `@tr()` with the "Library"
// context so the catalogs under `i18n/` list them together. Game titles, collection names and
// store names are never passed through here: the screens show them exactly as received.
import { Why, StatusKind, MatchKind, SourceKind, Standing, LaunchNote, SearchError, Outcome, AddError, AccessKind } from "library-state.slint";

export global LibraryText {
    pure public function status(kind: StatusKind) -> string {
        if kind == StatusKind.playing { return @tr("Library" => "Playing"); }
        if kind == StatusKind.finished { return @tr("Library" => "Finished"); }
        if kind == StatusKind.planned { return @tr("Library" => "Planned"); }
        if kind == StatusKind.dropped { return @tr("Library" => "Dropped"); }
        if kind == StatusKind.ongoing { return @tr("Library" => "Ongoing"); }
        return @tr("Library" => "Unknown status");
    }

    pure public function match-kind(kind: MatchKind) -> string {
        if kind == MatchKind.matched { return @tr("Library" => "Matched"); }
        if kind == MatchKind.ambiguous { return @tr("Library" => "Several possible matches"); }
        if kind == MatchKind.no-game { return @tr("Library" => "Not on GameNode"); }
        return @tr("Library" => "Not matched");
    }

    pure public function source(kind: SourceKind) -> string {
        if kind == SourceKind.chosen { return @tr("Library" => "You chose this match"); }
        if kind == SourceKind.automatic { return @tr("Library" => "Matched automatically"); }
        return "";
    }

    pure public function standing(kind: Standing, status: StatusKind) -> string {
        if kind == Standing.checking { return @tr("Library" => "Checking your GameNode library…"); }
        if kind == Standing.in-library {
            if status == StatusKind.unknown { return @tr("Library" => "In your GameNode library"); }
            return @tr("Library" => "In your GameNode library as {}", LibraryText.status(status));
        }
        if kind == Standing.not-in-library { return @tr("Library" => "Not in your GameNode library"); }
        if kind == Standing.unavailable { return @tr("Library" => "Could not check your GameNode library"); }
        return "";
    }

    // The sentence beside a disabled action.
    pure public function why(reason: Why, status: StatusKind) -> string {
        if reason == Why.nothing-selected { return @tr("Library" => "Select a game first."); }
        if reason == Why.multiple-selected { return @tr("Library" => "Select a single game."); }
        if reason == Why.no-launch-rule { return @tr("Library" => "This store cannot start games from GameNode."); }
        if reason == Why.no-install-rule { return @tr("Library" => "This store cannot install games from GameNode."); }
        if reason == Why.missing-field { return @tr("Library" => "Details this action needs are missing. Rescan to refresh them."); }
        if reason == Why.needs-verified-session { return @tr("Library" => "Your GameNode session is not verified yet. Retry the connection."); }
        if reason == Why.offline { return @tr("Library" => "GameNode cannot be reached right now."); }
        if reason == Why.not-matched { return @tr("Library" => "Match this game to a GameNode game first."); }
        if reason == Why.no-matched-games { return @tr("Library" => "None of the selected games is matched to a GameNode game."); }
        if reason == Why.checking-membership { return @tr("Library" => "Checking your GameNode library…"); }
        if reason == Why.membership-unavailable { return @tr("Library" => "Could not check your GameNode library. Try again."); }
        if reason == Why.already-in-library {
            if status == StatusKind.unknown { return @tr("Library" => "Already in your GameNode library."); }
            return @tr("Library" => "Already in your GameNode library as {}.", LibraryText.status(status));
        }
        return "";
    }

    pure public function launch(note: LaunchNote) -> string {
        if note == LaunchNote.opening-play { return @tr("Library" => "Opening the game in its store…"); }
        if note == LaunchNote.opening-install { return @tr("Library" => "Opening the store to install…"); }
        if note == LaunchNote.no-handler { return @tr("Library" => "The store application is not installed or cannot be opened."); }
        if note == LaunchNote.failed { return @tr("Library" => "The link could not be opened."); }
        if note == LaunchNote.incomplete { return @tr("Library" => "Details for this game are missing. Rescan and try again."); }
        if note == LaunchNote.unsupported { return @tr("Library" => "This store does not support that action."); }
        return "";
    }

    pure public function access(kind: AccessKind) -> string {
        if kind == AccessKind.offline { return @tr("Library" => "GameNode cannot be reached. Showing your saved library."); }
        if kind == AccessKind.unverified { return @tr("Library" => "Showing your saved library. Matching and adding to GameNode wait for your session to be verified."); }
        return "";
    }

    pure public function search-error(kind: SearchError, blocked: Why) -> string {
        if kind == SearchError.blocked { return LibraryText.why(blocked, StatusKind.unknown); }
        if kind == SearchError.rejected { return @tr("Library" => "GameNode rejected your session. Sign in again."); }
        if kind == SearchError.failed { return @tr("Library" => "The search failed. Check your connection and try again."); }
        return "";
    }

    pure public function add-error(kind: AddError) -> string {
        if kind == AddError.rejected { return @tr("Library" => "GameNode rejected your session. Sign in again."); }
        if kind == AddError.failed { return @tr("Library" => "Could not save the game. Your choices are kept; try again."); }
        return "";
    }

    pure public function outcome(kind: Outcome, status: StatusKind) -> string {
        if kind == Outcome.added { return @tr("Library" => "Saved as {}", LibraryText.status(status)); }
        if kind == Outcome.already-present {
            if status == StatusKind.unknown { return @tr("Library" => "Already in your library"); }
            return @tr("Library" => "Already in your library as {}", LibraryText.status(status));
        }
        if kind == Outcome.skipped { return @tr("Library" => "Skipped: no GameNode match"); }
        return @tr("Library" => "Failed");
    }
}
