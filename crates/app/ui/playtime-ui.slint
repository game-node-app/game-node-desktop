import { Theme } from "theme.slint";
import { Action, Caption, Heading } from "controls.slint";

export component SyncExplanation inherits Rectangle {
    in property <bool> shown;
    in property <bool> background-supported;
    callback dismissed(bool);
    visible: root.shown;
    background: #161616E6;
    private property <bool> second-focused;
    changed shown => { if root.shown { root.second-focused = false; keep.focus(); } }
    TouchArea { }
    forward-focus: scope;
    scope := FocusScope {
        enabled: root.shown;
        key-pressed(event) => {
            if event.text == Key.Escape { root.dismissed(false); return accept; }
            if event.text == Key.Tab {
                root.second-focused = !root.second-focused;
                if root.second-focused { settings.focus(); } else { keep.focus(); }
                return accept;
            }
            return reject;
        }
        Rectangle {
            x: max(16px, (parent.width - self.width) / 2);
            y: max(16px, (parent.height - self.height) / 2);
            width: min(520px, parent.width - 32px);
            height: layout.preferred-height;
            background: Theme.color-secondary;
            border-radius: Theme.radius-md;
            layout := VerticalLayout {
                padding: 24px; spacing: 16px;
                Heading { text: @tr("AppWindow" => "Sync with GameNode"); }
                Caption { text: @tr("AppWindow" => "Sync is on. Store playtime totals are sent to your GameNode account. You can turn sync off in Settings and keep using your library."); wrap: word-wrap; }
                if root.background-supported: Caption { text: @tr("AppWindow" => "Closing the window keeps GameNode running in the tray. Use Quit to exit."); wrap: word-wrap; }
                HorizontalLayout {
                    spacing: 12px;
                    keep := Action { text: @tr("AppWindow" => "Keep sync on"); primary: true; clicked => { root.dismissed(false); } }
                    settings := Action { text: @tr("AppWindow" => "Open settings"); outlined: true; clicked => { root.dismissed(true); } }
                }
            }
        }
    }
}
