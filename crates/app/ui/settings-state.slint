export enum SettingsTopic { account, stores, backups, tools, advanced, about }
export enum ToastKind { success, warning, danger }

export global SettingsState {
    in-out property <bool> open: false;
    in-out property <SettingsTopic> topic: SettingsTopic.account;
    in-out property <bool> dirty: false;
    in-out property <bool> alert-open: false;
    in-out property <SettingsTopic> pending-topic: SettingsTopic.account;
    in-out property <bool> pending-close: false;
    in-out property <string> toast-text: "";
    in-out property <ToastKind> toast-kind: ToastKind.success;
    in-out property <int> toast-serial: 0;
    in-out property <bool> toast-open: false;
    in-out property <string> destination-edit: "";

    pure function localize-toast(text: string) -> string {
        return text == "Library rescanned" ? @tr("Settings" => "Library rescanned") :
               text == "Backup destination saved" ? @tr("Settings" => "Backup destination saved") :
               text == "Tool cache cleared" ? @tr("Settings" => "Tool cache cleared") :
               text == "Biblioteca reescaneada" ? @tr("Settings" => "Library rescanned") :
               text == "Destino de backup salvo" ? @tr("Settings" => "Backup destination saved") :
               text == "Cache de ferramentas limpo" ? @tr("Settings" => "Tool cache cleared") :
               text;
    }

    callback show-toast(ToastKind, string);

    public function trigger-toast(kind: ToastKind, text: string) {
        root.toast-kind = kind;
        root.toast-text = root.localize-toast(text);
        root.toast-serial = root.toast-serial + 1;
        root.toast-open = true;
    }

    show-toast(kind, text) => {
        root.trigger-toast(kind, text);
    }

    public function select-topic(new-topic: SettingsTopic) {
        if root.topic == new-topic {
            return;
        }
        if root.dirty {
            root.pending-topic = new-topic;
            root.pending-close = false;
            root.alert-open = true;
        } else {
            root.topic = new-topic;
        }
    }

    public function request-close() {
        if root.dirty {
            root.pending-close = true;
            root.alert-open = true;
        } else {
            root.open = false;
        }
    }

    public function discard-and-continue() {
        root.dirty = false;
        root.alert-open = false;
        if root.pending-close {
            root.pending-close = false;
            root.open = false;
        } else {
            root.topic = root.pending-topic;
        }
    }

    public function cancel-alert() {
        root.alert-open = false;
        root.pending-close = false;
    }
}
