import { Theme } from "theme.slint";

export global SettingsStyle {
    // Cores (aliases para Theme onde coincide)
    out property <color> bg-base: #0B0B0B;
    out property <color> bg-sidebar: Theme.color-chrome;
    out property <color> bg-surface: Theme.color-secondary;
    out property <color> bg-raised: Theme.color-raised;
    out property <color> border-subtle: Theme.color-border-subtle;
    out property <color> text-primary: #FFFFFF;
    out property <color> text-secondary: #ADADAD;
    out property <color> text-muted: #7A7A7A;
    out property <color> accent: Theme.color-primary;
    out property <color> accent-subtle: Theme.color-accent-subtle;
    out property <color> accent-hover: Theme.color-primary.brighter(10%);
    out property <color> accent-pressed: Theme.color-tertiary;
    out property <color> success: Theme.color-success;
    out property <color> success-subtle: #3DD68C1F;
    out property <color> warning: #F5A524;
    out property <color> warning-subtle: #F5A5241F;
    out property <color> danger: Theme.color-danger;
    out property <color> danger-subtle: Theme.color-danger-subtle;
    out property <color> danger-hover: Theme.color-danger.brighter(10%);
