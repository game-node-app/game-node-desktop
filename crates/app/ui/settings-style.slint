    out property <length> scroll-padding-top: 28px;
    out property <length> scroll-padding-x: 32px;
    out property <length> scroll-padding-x-compact: 20px;
    out property <length> scroll-padding-bottom: 40px;

    out property <length> section-gap: 32px;
    out property <length> section-header-gap: 16px;

    out property <length> row-padding-y: 16px;
    out property <length> row-padding-x: 20px;
