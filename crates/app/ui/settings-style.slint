    out property <length> scrollbar-width: 4px;
    out property <length> fade-height: 72px;

    out property <length> toggle-width: 33px;
    out property <length> toggle-height: 16px;
    out property <length> toggle-knob: 14px;
    out property <length> toggle-inset: 2px;

    out property <length> radio: 18px;
    out property <length> radio-on-border: 5px;
    out property <length> radio-off-border: 1.5px;

    out property <length> button-padding-y: 7px;
    out property <length> button-padding-x: 12px;
    out property <length> button-icon-gap: 6px;

    out property <length> input-padding-y: 10px;
