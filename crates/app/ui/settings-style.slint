    out property <color> scrollbar-thumb: #FFFFFF38;
    out property <color> fade-start: #0B0B0B00;
    out property <color> fade-end: #0B0B0B;
    out property <color> toggle-track-on: #1A1A1A;
    out property <color> toggle-track-off: #2E2E2E;
    out property <color> toggle-border: #2E2E2E;
    out property <color> toggle-knob-on: #F15025;
    out property <color> toggle-knob-off: #7A7A7A;
    out property <color> focus-ring: #F15025;

    // Sombras
    out property <color> shadow-modal-color: #0000008C;
    out property <length> shadow-modal-offset-y: 32px;
    out property <length> shadow-modal-blur: 80px;

    out property <color> shadow-alert-color: #00000099;
    out property <length> shadow-alert-offset-y: 24px;
    out property <length> shadow-alert-blur: 64px;

    out property <color> shadow-toast-color: #00000080;
    out property <length> shadow-toast-offset-y: 12px;
    out property <length> shadow-toast-blur: 32px;

    // Tipografia
    out property <length> type-title: 20px;
    out property <int> type-title-weight: 500;

    out property <length> type-section: 16px;
    out property <int> type-section-weight: 500;

    out property <length> type-label: 14px;
    out property <int> type-label-weight: 600;

    out property <length> type-body: 14px;
    out property <int> type-body-weight: 400;

    out property <length> type-caption: 13px;
    out property <int> type-caption-weight: 400;
    out property <length> space-caption-gap: 5px;

    out property <length> type-button: 13px;
    out property <int> type-button-weight: 500;

    out property <length> type-control: 13px;
    out property <int> type-control-weight: 400;

    out property <length> type-meta: 12px;
    out property <int> type-meta-weight: 400;

    out property <length> type-pill: 12px;
    out property <int> type-pill-weight: 500;

    out property <length> type-kbd: 11px;
    out property <int> type-kbd-weight: 500;

    out property <length> type-group: 11px;
    out property <int> type-group-weight: 600;
    out property <length> type-group-letter-spacing: 0.6px;

    // Espaçamentos e tamanhos
    out property <length> modal-max-width: 960px;
    out property <length> modal-max-height: 720px;
    out property <length> modal-margin: 24px;
    out property <length> modal-margin-compact: 16px;

    out property <length> sidebar-width: 216px;
    out property <length> sidebar-width-compact: 176px;
    out property <length> sidebar-padding-y: 16px;
    out property <length> sidebar-padding-x: 10px;
    out property <length> sidebar-gap: 14px;

    out property <length> user-avatar: 32px;
    out property <length> user-block-padding-y: 4px;
    out property <length> user-block-padding-x: 6px;
    out property <length> user-block-gap: 10px;

    out property <length> nav-gap: 2px;
    out property <length> nav-group-padding-bottom: 6px;
