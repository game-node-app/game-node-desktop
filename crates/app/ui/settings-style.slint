    out property <length> alert-padding-top: 24px;
    out property <length> alert-padding-x: 24px;
    out property <length> alert-padding-bottom: 20px;
    out property <length> alert-gap: 14px;
    out property <length> alert-header-gap: 12px;
    out property <length> alert-actions-padding-y: 16px;
    out property <length> alert-actions-padding-x: 24px;

    out property <length> toast-padding-y: 10px;
    out property <length> toast-padding-left: 14px;
    out property <length> toast-padding-right: 10px;
    out property <length> toast-gap: 12px;

    out property <length> focus-ring-width: 2px;
    out property <length> focus-ring-offset: 2px;

    // Raios
    out property <length> radius-scrollbar: 2px;
    out property <length> radius-kbd: 4px;
    out property <length> radius-nav: 6px;
    out property <length> radius-control: 8px;
    out property <length> radius-tile: 10px;
    out property <length> radius-card: 12px;
    out property <length> radius-modal: 16px;
    out property <length> radius-fade: 15px;
    out property <length> radius-pill: 999px;
