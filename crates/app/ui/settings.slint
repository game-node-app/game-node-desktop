import { ScrollView } from "std-widgets.slint";
import { SettingsStyle } from "settings-style.slint";
import { SettingsState, SettingsTopic, ToastKind } from "settings-state.slint";
import {
    SettingsGroupHeader,
    SettingsNavItem,
    SettingsUserBlock,
    Kbd,
    SettingsCloseButton,
    SettingsPanelHeader,
    SettingsSection,
    SettingsCard,
    SettingsRow,
    SettingsToggle,
    SettingsSegmented,
    SettingsButton,
    SettingsIconButton,
    SettingsCheckbox,
    SettingsInput,
    Pill,
    InfoBox,
    SettingsActionBar,
    SettingsScroll,
    Toast,
    AlertDialog,
} from "settings-controls.slint";
import { LibraryState, ProviderItem } from "library-state.slint";
import { LocalGames } from "drm-free.slint";
import { ToolsState, ToolCatalogRow } from "tools.slint";

export component SettingsModal inherits Rectangle {
    in property <bool> signed-in;
    in property <string> identity;
    in property <string> storage;
    in property <bool> sync-enabled;
    in property <bool> playtime-error;
    in property <bool> store-playtime;
    in-out property <bool> software;
    in property <bool> active-software;
    in property <bool> fallback-renderer;
    in property <string> version;
    in property <bool> busy;
    in property <bool> can-retry;
    in-out property <int> license-page;
    in property <int> license-page-count;
    in property <string> licenses;

    callback sign-in(int);
    callback cancel();
    callback retry();
    callback sign-out();
    callback sync-changed(bool);
    callback source-changed(bool);
    callback renderer-changed(bool);
    callback license-page-changed(int);

    // Estado local para edição do destino de backup
    property <string> destination-edit: SettingsState.destination-edit != "" ? SettingsState.destination-edit : LocalGames.destination;
    property <string> new-watch-folder: "";
    property <bool> licenses-open: false;

    property <bool> is-open: SettingsState.open;
    changed is-open => {
        if self.is-open {
            focus-scope.focus();
        }
    }

    // Modos de tamanho
    property <bool> is-compact: root.width < 760px;
    property <length> margin: root.is-compact ? SettingsStyle.modal-margin-compact : SettingsStyle.modal-margin;
    property <length> sidebar-w: root.is-compact ? SettingsStyle.sidebar-width-compact : SettingsStyle.sidebar-width;
    property <length> scroll-px: root.is-compact ? SettingsStyle.scroll-padding-x-compact : SettingsStyle.scroll-padding-x;

    visible: SettingsState.open;
    width: 100%;
    height: 100%;

    // Escurecimento de fundo
    overlay := Rectangle {
        width: 100%;
        height: 100%;
        background: SettingsStyle.overlay;

        TouchArea {
            clicked => {
                SettingsState.request-close();
            }
        }
    }

    // Modal centralizado
    modal-box := Rectangle {
        width: min(SettingsStyle.modal-max-width, root.width - 2 * root.margin);
        height: min(SettingsStyle.modal-max-height, root.height - 2 * root.margin);
        x: (root.width - self.width) / 2;
        y: (root.height - self.height) / 2;
        background: SettingsStyle.bg-base;
        border-radius: SettingsStyle.radius-modal;
        border-width: 1px;
        border-color: SettingsStyle.border-subtle;
        drop-shadow-color: SettingsStyle.shadow-modal-color;
        drop-shadow-offset-y: SettingsStyle.shadow-modal-offset-y;
        drop-shadow-blur: SettingsStyle.shadow-modal-blur;
        clip: true;

        TouchArea {
            // Consome cliques para não fechar clicando dentro do modal
        }

        HorizontalLayout {
            // Barra lateral
            sidebar := Rectangle {
                width: root.sidebar-w;
                background: SettingsStyle.bg-sidebar;

                VerticalLayout {
                    padding-top: SettingsStyle.sidebar-padding-y;
                    padding-bottom: SettingsStyle.sidebar-padding-y;
                    padding-left: SettingsStyle.sidebar-padding-x;
                    padding-right: SettingsStyle.sidebar-padding-x;
                    spacing: SettingsStyle.sidebar-gap;

                    SettingsUserBlock {
                        signed-in: root.signed-in;
                        display-name: root.identity;
                        status-text: root.signed-in ? @tr("Settings" => "Signed in") : @tr("Settings" => "No session");
                        initial: root.signed-in && root.identity != "" ? "U" : "";
                    }

                    Rectangle {
                        height: 1px;
                        background: SettingsStyle.border-subtle;
                    }

                    SettingsGroupHeader {
                        text: @tr("Settings" => "SETTINGS");
                    }

                    VerticalLayout {
                        spacing: SettingsStyle.nav-gap;

                        SettingsNavItem {
                            text: @tr("Settings" => "Account");
                            icon: @image-url("icons/settings/user.svg");
                            selected: SettingsState.topic == SettingsTopic.account;
                            clicked => { SettingsState.select-topic(SettingsTopic.account); }
                        }

                        SettingsNavItem {
                            text: @tr("Settings" => "Stores");
                            icon: @image-url("icons/settings/plug.svg");
                            selected: SettingsState.topic == SettingsTopic.stores;
                            clicked => { SettingsState.select-topic(SettingsTopic.stores); }
                        }

                        SettingsNavItem {
                            text: @tr("Settings" => "Backups");
                            icon: @image-url("icons/settings/shield.svg");
                            selected: SettingsState.topic == SettingsTopic.backups;
                            clicked => { SettingsState.select-topic(SettingsTopic.backups); }
                        }

                        SettingsNavItem {
                            text: @tr("Settings" => "Tools");
                            icon: @image-url("icons/settings/desktop.svg");
                            selected: SettingsState.topic == SettingsTopic.tools;
                            clicked => { SettingsState.select-topic(SettingsTopic.tools); }
                        }

                        SettingsNavItem {
                            text: @tr("Settings" => "Advanced");
                            icon: @image-url("icons/settings/desktop.svg");
                            selected: SettingsState.topic == SettingsTopic.advanced;
                            clicked => { SettingsState.select-topic(SettingsTopic.advanced); }
                        }

                        SettingsNavItem {
                            text: @tr("Settings" => "About");
                            icon: @image-url("icons/settings/book.svg");
                            selected: SettingsState.topic == SettingsTopic.about;
                            clicked => { SettingsState.select-topic(SettingsTopic.about); }
                        }
                    }

                    Rectangle {
                        vertical-stretch: 1;
                    }

                    Text {
                        text: "GameNode · " + root.version;
                        font-size: SettingsStyle.type-meta;
                        font-weight: SettingsStyle.type-meta-weight;
                        color: SettingsStyle.text-muted;
                        overflow: elide;
                    }
                }
            }

            // Divisória vertical
            Rectangle {
                width: 1px;
                background: SettingsStyle.border-subtle;
            }

            // Conteúdo do painel
            panel-area := VerticalLayout {
                horizontal-stretch: 1;

                // Cabeçalho fixo do painel
                header := SettingsPanelHeader {
                    title: SettingsState.topic == SettingsTopic.account ? @tr("Settings" => "Account") :
                           SettingsState.topic == SettingsTopic.stores ? @tr("Settings" => "Stores") :
                           SettingsState.topic == SettingsTopic.backups ? @tr("Settings" => "Backups") :
                           SettingsState.topic == SettingsTopic.tools ? @tr("Settings" => "Tools") :
                           SettingsState.topic == SettingsTopic.advanced ? @tr("Settings" => "Advanced") :
                           @tr("Settings" => "About");
                    description: SettingsState.topic == SettingsTopic.account ? @tr("Settings" => "Your GameNode connection and what this PC syncs.") :
                                 SettingsState.topic == SettingsTopic.stores ? @tr("Settings" => "Stores found on this PC and how playtime is read.") :
                                 SettingsState.topic == SettingsTopic.backups ? @tr("Settings" => "Local protection for your DRM-free game saves.") :
                                 SettingsState.topic == SettingsTopic.tools ? @tr("Settings" => "Upscalers, frame generation tools, and local download cache.") :
                                 SettingsState.topic == SettingsTopic.advanced ? @tr("Settings" => "Rendering and troubleshooting options.") :
                                 @tr("Settings" => "Version, license and third-party notices.");
                    close => { SettingsState.request-close(); }
                }

                // Área rolável
                scroll-view := SettingsScroll {
                    VerticalLayout {
                        x: 0px;
                        y: 0px;
                        height: self.preferred-height;
                        width: 100%;
                        alignment: start;
                        padding-top: SettingsStyle.scroll-padding-top;
                        padding-bottom: SettingsStyle.scroll-padding-bottom;
                        padding-left: root.scroll-px;
                        padding-right: root.scroll-px;
                        spacing: SettingsStyle.section-gap;

                        // ==========================================
                        // PAINEL: CONTA
                        // ==========================================
                        if SettingsState.topic == SettingsTopic.account : VerticalLayout {
                            alignment: start;
                            spacing: SettingsStyle.section-gap;

                            SettingsSection {
                                title: @tr("Settings" => "Session and identity");

                                SettingsCard {
                                    VerticalLayout {
                                    if root.signed-in : SettingsRow {
                                        title: root.identity;
                                        description: root.storage != "" ? root.storage : @tr("Settings" => "Your session stays on this device, protected by your operating system.");
                                        has-divider: true;

                                        SettingsButton {
                                            text: @tr("Settings" => "Sign out");
                                            variant: "danger";
                                            clicked => { root.sign-out(); }
                                        }
                                    }

                                    if !root.signed-in : VerticalLayout {
                                        padding-top: SettingsStyle.row-padding-y;
                                        padding-bottom: SettingsStyle.row-padding-y;
                                        padding-left: SettingsStyle.row-padding-x;
                                        padding-right: SettingsStyle.row-padding-x;
                                        spacing: 12px;

                                        Text {
                                            text: @tr("Sign in with your GameNode account in your browser.");
                                            font-size: SettingsStyle.type-body;
                                            font-weight: SettingsStyle.type-body-weight;
                                            color: SettingsStyle.text-secondary;
                                            wrap: word-wrap;
                                        }

                                        if !root.busy && !root.can-retry : HorizontalLayout {
                                            spacing: 8px;

                                            SettingsButton {
                                                text: "Google";
                                                variant: "primary";
                                                has-icon: true;
                                                icon: @image-url("icons/settings/google.svg");
                                                clicked => { root.sign-in(0); }
                                            }

                                            SettingsButton {
                                                text: "Discord";
                                                variant: "secondary";
                                                has-icon: true;
                                                icon: @image-url("icons/settings/discord.svg");
                                                clicked => { root.sign-in(1); }
                                            }

                                            SettingsButton {
                                                text: "X";
                                                variant: "secondary";
                                                has-icon: true;
                                                icon: @image-url("icons/settings/x.svg");
                                                clicked => { root.sign-in(2); }
                                            }
                                        }

                                        if root.busy : SettingsButton {
                                            text: @tr("Cancel sign-in");
                                            variant: "secondary";
                                            clicked => { root.cancel(); }
                                        }

                                        if root.can-retry : SettingsButton {
                                            text: @tr("Retry connection");
                                            variant: "primary";
                                            clicked => { root.retry(); }
                                        }
                                    }
                                    }
                                }
                            }

                            SettingsSection {
                                title: @tr("Settings" => "Sync");

                                SettingsCard {
                                    SettingsRow {
                                        title: @tr("AppWindow" => "Sync with GameNode");
                                        description: @tr("Settings" => "Playtime totals are sent to your GameNode account. You can turn sync off in Settings and keep using your library.");

                                        SettingsToggle {
                                            checked: root.sync-enabled;
                                            toggled(v) => { root.sync-changed(v); }
                                        }
                                    }
                                }

                                if root.playtime-error : InfoBox {
                                    text: @tr("Could not sync playtime. Your local data is preserved.");
                                    has-icon: true;
                                    icon: @image-url("icons/settings/alert.svg");
                                }
                            }
                        }

                        // ==========================================
                        // PAINEL: LOJAS
                        // ==========================================
                        if SettingsState.topic == SettingsTopic.stores : VerticalLayout {
                            alignment: start;
                            spacing: SettingsStyle.section-gap;

                            SettingsSection {
                                title: @tr("Settings" => "Detected stores");
                                description: @tr("Settings" => "Game providers configured on this system.");

                                SettingsCard {
                                    VerticalLayout {
                                    for provider[idx] in LibraryState.providers : SettingsRow {
                                        title: provider.name;
                                        description: provider.failed ? @tr("Settings" => "Last scan failed") :
                                                     provider.count > 0 ? (provider.count + " " + @tr("Settings" => "installed games")) :
                                                     @tr("Settings" => "No installed games found");
                                        has-divider: idx < LibraryState.providers.length - 1;

                                        if provider.failed : Pill {
                                            text: @tr("Settings" => "Failed");
                                            variant: "warning";
                                        }
                                    }
                                    }
                                }

                                HorizontalLayout {
                                    alignment: start;
                                    spacing: 8px;
                                    SettingsButton {
                                        text: @tr("Library" => "Rescan");
                                        variant: "secondary";
                                        enabled: !LibraryState.scanning;
                                        busy: LibraryState.scanning;
                                        has-icon: true;
                                        icon: @image-url("icons/settings/restart.svg");
                                        clicked => { LibraryState.rescan(); }
                                    }
                                    SettingsButton {
                                        text: @tr("DRM-free" => "Reset ignored discoveries");
                                        variant: "ghost";
                                        enabled: !LibraryState.scanning && !LocalGames.busy;
                                        clicked => { LocalGames.ignores-reset(); }
                                    }
                                }
                            }

                            SettingsSection {
                                title: @tr("AppWindow" => "Playtime source");
                                description: @tr("AppWindow" => "Applies to all games on this PC. Games without a supported store counter always use the internal counter. Store and internal histories stay separate.");

                                SettingsCard {
                                    SettingsRow {
                                        title: @tr("Settings" => "Playtime source");

                                        SettingsSegmented {
                                            options: [@tr("Settings" => "Store"), @tr("Settings" => "Internal")];
                                            selected-index: root.store-playtime ? 0 : 1;
                                            changed(idx) => { root.source-changed(idx == 0); }
                                        }
                                    }
                                }
                            }

                            SettingsSection {
                                title: @tr("DRM-free" => "DRM-free games");
                                description: @tr("Settings" => "Watched folders and local discoveries.");

                                if !LocalGames.supported : InfoBox {
                                    text: @tr("Settings" => "Unavailable on this system");
                                }

                                if LocalGames.supported : VerticalLayout {
                                    spacing: 12px;

                                    SettingsCard {
                                        VerticalLayout {
                                            padding-top: SettingsStyle.row-padding-y;
                                            padding-bottom: SettingsStyle.row-padding-y;
                                            padding-left: SettingsStyle.row-padding-x;
                                            padding-right: SettingsStyle.row-padding-x;
                                            spacing: 12px;

                                            HorizontalLayout {
                                                spacing: 8px;

                                                SettingsInput {
                                                    text: root.new-watch-folder;
                                                    placeholder: @tr("DRM-free" => "Folder to watch");
                                                    has-error: LocalGames.error != "";
                                                    error-text: LocalGames.error;
                                                    edited(v) => { root.new-watch-folder = v; }
                                                    horizontal-stretch: 1;
                                                }

                                                SettingsButton {
                                                    text: @tr("DRM-free" => "Watch folder");
                                                    variant: "secondary";
                                                    enabled: !LocalGames.busy;
                                                    clicked => {
                                                        if root.new-watch-folder == "" {
                                                            LocalGames.watch-folder-pick();
                                                        } else {
                                                            LocalGames.watch-folder(root.new-watch-folder);
                                                        }
                                                    }
                                                }
                                            }

                                            for watched in LocalGames.watches : SettingsRow {
                                                title: watched.folder;
                                                has-divider: true;

                                                SettingsButton {
                                                    text: @tr("DRM-free" => "Remove watch");
                                                    variant: "ghost";
                                                    clicked => { LocalGames.watch-remove(watched.fingerprint); }
                                                }
                                            }

                                            if LocalGames.discovery-scanning : Text {
                                                text: @tr("DRM-free" => "Checking watched folders…");
                                                color: SettingsStyle.text-secondary;
                                                wrap: word-wrap;
                                            }
                                            if !LocalGames.discovery-scanning && LocalGames.discovery-error != "" : Text {
                                                text: LocalGames.discovery-error;
                                                color: SettingsStyle.danger;
                                                wrap: word-wrap;
                                            }
                                            if !LocalGames.discovery-scanning && LocalGames.discovery-error == "" && LocalGames.discovery-incomplete : Text {
                                                text: @tr("DRM-free" => "Some folders could not be checked completely.");
                                                color: SettingsStyle.text-secondary;
                                                wrap: word-wrap;
                                            }
                                            if !LocalGames.discovery-scanning && LocalGames.discovery-error == "" && LocalGames.discovery-completed : Text {
                                                text: @tr("DRM-free" => "Recognized games in watched folders are added to your library automatically.");
                                                color: SettingsStyle.text-secondary;
                                                wrap: word-wrap;
                                            }

                                            VerticalLayout {
                                                spacing: 8px;

                                                SettingsButton {
                                                    text: @tr("DRM-free" => "Rescan watched folders");
                                                    variant: "secondary";
                                                    busy: LocalGames.busy || LocalGames.discovery-scanning;
                                                    clicked => { LocalGames.discovery-rescan(); }
                                                }

                                                SettingsButton {
                                                    text: @tr("DRM-free" => "Reset ignored discoveries");
                                                    variant: "ghost";
                                                    enabled: !LocalGames.busy;
                                                    clicked => { LocalGames.ignores-reset(); }
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }

                        // ==========================================
                        // PAINEL: BACKUPS
                        // ==========================================
                        if SettingsState.topic == SettingsTopic.backups : VerticalLayout {
                            alignment: start;
                            spacing: SettingsStyle.section-gap;

                            if !LocalGames.supported : InfoBox {
                                text: @tr("Settings" => "Unavailable on this system");
                            }

                            if LocalGames.supported : VerticalLayout {
                                alignment: start;
                                spacing: SettingsStyle.section-gap;

                                InfoBox {
                                    text: @tr("DRM-free" => "Backups stay on this PC. A backup on the same drive cannot protect against drive loss.");
                                    has-icon: true;
                                    icon: @image-url("icons/settings/shield.svg");
                                }

                                SettingsSection {
                                    title: @tr("Settings" => "Automatic protection");

                                    SettingsCard {
                                        SettingsRow {
                                            title: @tr("DRM-free" => "Automatic backups");
                                            description: @tr("Settings" => "Generates local backups automatically.");

                                            SettingsToggle {
                                                checked: LocalGames.automatic;
                                                toggled(v) => { LocalGames.backup-settings(v, LocalGames.destination); }
                                            }
                                        }
                                    }
                                }

                                SettingsSection {
                                    title: @tr("DRM-free" => "Backup destination");
                                    description: @tr("Settings" => "Local folder where DRM-free game backups are saved.");

                                    SettingsCard {
                                        VerticalLayout {
                                            padding-top: SettingsStyle.row-padding-y;
                                            padding-bottom: SettingsStyle.row-padding-y;
                                            padding-left: SettingsStyle.row-padding-x;
                                            padding-right: SettingsStyle.row-padding-x;
                                            spacing: 12px;

                                            HorizontalLayout {
                                                spacing: 8px;

                                                SettingsInput {
                                                    text: root.destination-edit != "" ? root.destination-edit : LocalGames.destination;
                                                    has-error: LocalGames.error != "";
                                                    error-text: LocalGames.error;
                                                    edited(v) => {
                                                        root.destination-edit = v;
                                                        SettingsState.dirty = (v != LocalGames.destination);
                                                    }
                                                    horizontal-stretch: 1;
                                                }

                                                SettingsButton {
                                                    text: @tr("Settings" => "Choose folder…");
                                                    variant: "secondary";
                                                    clicked => { LocalGames.destination-pick(); }
                                                }
                                            }

                                            SettingsActionBar {
                                                dirty: SettingsState.dirty;
                                                saving: LocalGames.busy;
                                                discard-text: @tr("Settings" => "Discard");
                                                save-text: @tr("Settings" => "Save changes");
                                                unsaved-text: @tr("Settings" => "Unsaved changes");
                                                discard => {
                                                    root.destination-edit = LocalGames.destination;
                                                    SettingsState.dirty = false;
                                                }
                                                save => {
                                                    LocalGames.backup-settings(LocalGames.automatic, root.destination-edit);
                                                    SettingsState.dirty = false;
                                                }
                                            }
                                        }
                                    }
                                }

                                InfoBox {
                                    text: @tr("Settings" => "Per-game controls are in each game's details.");
                                }
                            }
                        }

                        // ==========================================
                        // PAINEL: FERRAMENTAS (TOOLS)
                        // ==========================================
                        if SettingsState.topic == SettingsTopic.tools : VerticalLayout {
                            alignment: start;
                            spacing: SettingsStyle.section-gap;

                            SettingsSection {
                                title: @tr("Settings" => "Tool download cache");
                                description: @tr("Settings" => "Archives downloaded from GitHub for offline install and reuse across games.");

                                SettingsCard {
                                    SettingsRow {
                                        title: @tr("Settings" => "Cached archives");
                                        description: ToolsState.cache-archive-count > 0 ? (ToolsState.cache-archive-count + " " + @tr("Settings" => "archives cached") + " (" + ToolsState.cache-size-text + ")") : @tr("Settings" => "No tool archives cached");
                                        has-divider: false;

                                        HorizontalLayout {
                                            spacing: 8px;
                                            alignment: end;

                                            Pill {
                                                text: ToolsState.cache-size-text;
                                                variant: "neutral";
                                                y: (parent.height - self.height) / 2;
                                            }

                                            SettingsButton {
                                                text: @tr("Settings" => "Check for updates");
                                                variant: "secondary";
                                                busy: ToolsState.loading-versions;
                                                clicked => { ToolsState.refresh-versions(); }
                                            }

                                            SettingsButton {
                                                text: @tr("Settings" => "Clear cache");
                                                variant: "ghost";
                                                enabled: ToolsState.cache-archive-count > 0;
                                                clicked => { ToolsState.clear-cache(); }
                                            }
                                        }
                                    }
                                }
                            }

                            SettingsSection {
                                title: @tr("Settings" => "Supported tools");
                                description: @tr("Settings" => "Built-in tool catalog and official open-source licenses.");

                                SettingsCard {
                                    VerticalLayout {
                                        for tool[idx] in ToolsState.catalog : SettingsRow {
                                            title: tool.name;
                                            description: tool.summary;
                                            has-divider: idx < ToolsState.catalog.length - 1;

                                            HorizontalLayout {
                                                spacing: 8px;
                                                alignment: end;

                                                Pill {
                                                    text: tool.license;
                                                    variant: "neutral";
                                                    y: (parent.height - self.height) / 2;
                                                }

                                                SettingsButton {
                                                    text: @tr("Tools" => "Source");
                                                    variant: "ghost";
                                                    clicked => { ToolsState.open-source(tool.source-url); }
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }

                        // ==========================================
                        // PAINEL: AVANÇADO
                        // ==========================================
                        if SettingsState.topic == SettingsTopic.advanced : VerticalLayout {
                            alignment: start;
                            spacing: SettingsStyle.section-gap;

                            SettingsSection {
                                title: @tr("AppWindow" => "Appearance & performance");
                                description: @tr("Settings" => "Rendering and troubleshooting options.");

                                SettingsCard {
                                    VerticalLayout {
                                    SettingsRow {
                                        title: @tr("AppWindow" => "Software rendering");
                                        description: @tr("AppWindow" => "Use if you experience graphics issues. Takes effect after restarting GameNode.");
                                        has-divider: true;

                                        HorizontalLayout {
                                            spacing: 8px;
                                            alignment: end;

                                            if root.software != root.active-software : Pill {
                                                text: @tr("Settings" => "Requires restart");
                                                variant: "warning";
                                                y: (parent.height - self.height) / 2;
                                            }

                                            SettingsToggle {
                                                checked: root.software;
                                                toggled(v) => {
                                                    root.software = v;
                                                    root.renderer-changed(v);
                                                }
                                            }
                                        }
                                    }

                                    SettingsRow {
                                        title: @tr("Settings" => "Active renderer");
                                        description: root.fallback-renderer ? @tr("AppWindow" => "Active renderer: Software (automatic fallback)") :
                                                     root.active-software ? @tr("AppWindow" => "Active renderer: Software") : @tr("AppWindow" => "Active renderer: Skia");

                                        Pill {
                                            text: root.fallback-renderer ? "Software (fallback)" : (root.active-software ? "Software" : "Skia");
                                            variant: root.fallback-renderer ? "warning" : "neutral";
                                        }
                                    }
                                    }
                                }
                            }
                        }

                        // ==========================================
                        // PAINEL: SOBRE
                        // ==========================================
                        if SettingsState.topic == SettingsTopic.about : VerticalLayout {
                            alignment: start;
                            spacing: SettingsStyle.section-gap;

                            SettingsSection {
                                title: @tr("Settings" => "About GameNode Desktop");

                                SettingsCard {
                                    VerticalLayout {
                                        padding-top: SettingsStyle.row-padding-y;
                                        padding-bottom: SettingsStyle.row-padding-y;
                                        padding-left: SettingsStyle.row-padding-x;
                                        padding-right: SettingsStyle.row-padding-x;
                                        spacing: 16px;

                                        HorizontalLayout {
                                            spacing: 16px;
                                            alignment: start;

                                            Image {
                                                width: 72.8px;
                                                height: 28px;
                                                source: @image-url("icons/gamenode-logo.svg");
                                                image-fit: contain;
                                                y: (parent.height - self.height) / 2;
                                            }

                                            VerticalLayout {
                                                spacing: 2px;
                                                Text {
                                                    text: "GameNode Desktop";
                                                    font-size: SettingsStyle.type-section;
                                                    font-weight: SettingsStyle.type-section-weight;
                                                    color: SettingsStyle.text-primary;
                                                }
                                                Text {
                                                    text: @tr("Version {}", root.version) + " · GPL-3.0-only";
                                                    font-size: SettingsStyle.type-caption;
                                                    font-weight: SettingsStyle.type-caption-weight;
                                                    color: SettingsStyle.text-secondary;
                                                }
                                            }
                                        }

                                        Rectangle {
                                            height: 1px;
                                            background: SettingsStyle.border-subtle;
                                        }

                                        Text {
                                            text: @tr("GameNode artwork: GPL-3.0-only · Roboto: SIL Open Font License 1.1 · Slint: GPLv3");
                                            font-size: SettingsStyle.type-caption;
                                            font-weight: SettingsStyle.type-caption-weight;
                                            color: SettingsStyle.text-secondary;
                                            wrap: word-wrap;
                                        }

                                        HorizontalLayout {
                                            alignment: start;
                                            SettingsButton {
                                                text: @tr("Show license notices");
                                                variant: "secondary";
                                                has-icon: true;
                                                icon: @image-url("icons/settings/book.svg");
                                                clicked => { root.licenses-open = true; }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }

        // Toast posicionado no rodapé do painel
        if SettingsState.toast-open : Toast {
            width: min(parent.width - 32px, self.preferred-width);
            height: self.preferred-height;
            x: (parent.width - self.width) / 2;
            y: parent.height - self.height - 24px;
            text: SettingsState.toast-text;
            kind: SettingsState.toast-kind == ToastKind.success ? "success" :
                  SettingsState.toast-kind == ToastKind.warning ? "warning" : "danger";
            open: SettingsState.toast-open;
            close => { SettingsState.toast-open = false; }
        }

        // Timer de 4 segundos para o toast
        toast-timer := Timer {
            interval: 4s;
            running: SettingsState.toast-open;
            triggered => {
                SettingsState.toast-open = false;
            }
        }

        // Diálogo de alerta para confirmação de descarte de alterações
        if SettingsState.alert-open : AlertDialog {
            open: SettingsState.alert-open;
            title: @tr("Settings" => "Discard changes?");
            message: @tr("Settings" => "You have unsaved changes. Do you want to discard them?");
            cancel-text: @tr("Settings" => "Cancel");
            confirm-text: @tr("Settings" => "Discard");
            confirm-variant: "danger";
            cancel => { SettingsState.cancel-alert(); }
            confirm => {
                root.destination-edit = LocalGames.destination;
                SettingsState.discard-and-continue();
            }
        }

        // Diálogo largo de licenças aberto sobre o modal
        if root.licenses-open : Rectangle {
            width: 100%;
            height: 100%;
            background: SettingsStyle.overlay;

            TouchArea {
                clicked => { root.licenses-open = false; }
            }

            Rectangle {
                x: max(16px, (parent.width - self.width) / 2);
                y: max(16px, (parent.height - self.height) / 2);
                width: min(720px, parent.width - 32px);
                height: min(560px, parent.height - 64px);
                background: SettingsStyle.bg-surface;
                border-width: 1px;
                border-color: SettingsStyle.border-subtle;
                border-radius: SettingsStyle.radius-modal;
                drop-shadow-color: SettingsStyle.shadow-alert-color;
                drop-shadow-offset-y: SettingsStyle.shadow-alert-offset-y;
                drop-shadow-blur: SettingsStyle.shadow-alert-blur;
                clip: true;

                TouchArea {
                    // Consome cliques
                }

                VerticalLayout {
                    // Cabeçalho
                    SettingsPanelHeader {
                        title: @tr("AppWindow" => "License notices");
                        show-close: true;
                        close => { root.licenses-open = false; }
                    }

                    // Conteúdo de texto
                    ScrollView {
                        vertical-stretch: 1;

                        VerticalLayout {
                            padding-left: 24px;
                            padding-right: 24px;
                            padding-top: 16px;
                            padding-bottom: 16px;

                            Text {
                                text: root.licenses;
                                font-size: SettingsStyle.type-caption;
                                font-weight: SettingsStyle.type-caption-weight;
                                color: SettingsStyle.text-secondary;
                                wrap: word-wrap;
                            }
                        }
                    }

                    // Paginação e rodapé
                    Rectangle {
                        background: SettingsStyle.bg-base;

                        Rectangle {
                            y: 0px;
                            height: 1px;
                            width: 100%;
                            background: SettingsStyle.border-subtle;
                        }

                        HorizontalLayout {
                            padding-top: 12px;
                            padding-bottom: 12px;
                            padding-left: 24px;
                            padding-right: 24px;
                            alignment: space-between;

                            HorizontalLayout {
                                spacing: 8px;
                                alignment: start;

                                SettingsButton {
                                    text: "<";
                                    variant: "ghost";
                                    enabled: root.license-page > 0;
                                    clicked => {
                                        root.license-page = root.license-page - 1;
                                        root.license-page-changed(root.license-page);
                                    }
                                }

                                Text {
                                    text: (root.license-page + 1) + " / " + root.license-page-count;
                                    font-size: SettingsStyle.type-meta;
                                    font-weight: SettingsStyle.type-meta-weight;
                                    color: SettingsStyle.text-muted;
                                    vertical-alignment: center;
                                }

                                SettingsButton {
                                    text: ">";
                                    variant: "ghost";
                                    enabled: root.license-page + 1 < root.license-page-count;
                                    clicked => {
                                        root.license-page = root.license-page + 1;
                                        root.license-page-changed(root.license-page);
                                    }
                                }
                            }

                            SettingsButton {
                                text: @tr("Settings" => "Close");
                                variant: "secondary";
                                clicked => { root.licenses-open = false; }
                            }
                        }
                    }
                }
            }
        }
    }

    focus-scope := FocusScope {
        enabled: SettingsState.open;
        // This shortcut scope spans the modal. Let the actual controls receive presses.
        focus-on-click: false;
        key-pressed(event) => {
            if event.text == Key.Escape {
                if root.licenses-open {
                    root.licenses-open = false;
                    return accept;
                }
                if SettingsState.alert-open {
                    SettingsState.cancel-alert();
                    return accept;
                }
                SettingsState.request-close();
                return accept;
            }
            if event.text == Key.UpArrow {
                if SettingsState.topic == SettingsTopic.about {
                    SettingsState.select-topic(SettingsTopic.advanced);
                } else if SettingsState.topic == SettingsTopic.advanced {
                    SettingsState.select-topic(SettingsTopic.backups);
                } else if SettingsState.topic == SettingsTopic.backups {
                    SettingsState.select-topic(SettingsTopic.stores);
                } else if SettingsState.topic == SettingsTopic.stores {
                    SettingsState.select-topic(SettingsTopic.account);
                }
                return accept;
            }
            if event.text == Key.DownArrow {
                if SettingsState.topic == SettingsTopic.account {
                    SettingsState.select-topic(SettingsTopic.stores);
                } else if SettingsState.topic == SettingsTopic.stores {
                    SettingsState.select-topic(SettingsTopic.backups);
                } else if SettingsState.topic == SettingsTopic.backups {
                    SettingsState.select-topic(SettingsTopic.advanced);
                } else if SettingsState.topic == SettingsTopic.advanced {
                    SettingsState.select-topic(SettingsTopic.about);
                }
                return accept;
            }
            return reject;
        }
    }
}
