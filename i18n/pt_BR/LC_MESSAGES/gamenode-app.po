msgctxt "AppWindow"
msgid "Active renderer: Skia"
msgstr "Renderizador ativo: Skia"

msgctxt "AppWindow"
msgid "Active renderer: Software"
msgstr "Renderizador ativo: software"

msgctxt "AppWindow"
msgid "Active renderer: Software (automatic fallback)"
msgstr "Renderizador ativo: software (fallback automático)"

msgctxt "AppWindow"
msgid "GameNode could not initialize either renderer.\nSkia error: {gpu}\nSoftware error: {software}\nYour saved settings and session were preserved. Update your graphics driver or contact support with these details."
msgstr "O GameNode não conseguiu iniciar nenhum dos renderizadores.\nErro do Skia: {gpu}\nErro da renderização por software: {software}\nSuas configurações e sessão foram preservadas. Atualize o driver gráfico ou entre em contato com o suporte com estes detalhes."

msgctxt "AppWindow"
msgid "GameNode could not initialize software rendering.\nError: {software}\nYour saved settings and session were preserved. Update your graphics driver or contact support with these details."
msgstr "O GameNode não conseguiu iniciar a renderização por software.\nErro: {software}\nSuas configurações e sessão foram preservadas. Atualize o driver gráfico ou entre em contato com o suporte com estes detalhes."

msgctxt "AppWindow"
msgid "Skia failed to initialize: {gpu}\nGameNode could not restart with software rendering: {error}\nYour saved settings and session were preserved. Restart after updating your graphics driver."
msgstr "Falha ao iniciar o Skia: {gpu}\nO GameNode não conseguiu reiniciar com renderização por software: {error}\nSuas configurações e sessão foram preservadas. Reinicie após atualizar o driver gráfico."

msgctxt "AppWindow"
msgid "Back"
msgstr "Voltar"

msgctxt "AppWindow"
msgid "Cancel sign-in"
msgstr "Cancelar entrada"

msgctxt "AppWindow"
msgid "Complete sign-in in your browser."
msgstr "Conclua a entrada no navegador."

msgctxt "AppWindow"
msgid "Continue with Discord"
msgstr "Continuar com Discord"

msgctxt "AppWindow"
msgid "Continue with Google"
msgstr "Continuar com Google"

msgctxt "AppWindow"
msgid "Continue with Twitter"
msgstr "Continuar com Twitter"

msgctxt "AppWindow"
msgid "Could not connect. Your stored session is preserved; retry when online."
msgstr "Não foi possível conectar. Sua sessão foi preservada; tente novamente quando estiver online."

msgctxt "AppWindow"
msgid "Could not open your browser. Please try again."
msgstr "Não foi possível abrir o navegador. Tente novamente."

msgctxt "AppWindow"
msgid "Could not read your session from credential storage."
msgstr "Não foi possível ler a sessão no armazenamento de credenciais."

msgctxt "AppWindow"
msgid "Could not remove the saved credential. Check credential storage before restarting."
msgstr "Não foi possível remover a credencial salva. Verifique o armazenamento de credenciais antes de reiniciar."

msgctxt "AppWindow"
msgid "Could not save your session. Sign-in will not survive restart."
msgstr "Não foi possível salvar a sessão. Será necessário entrar novamente após reiniciar."

msgctxt "AppWindow"
msgid "Could not start sign-in. Please try again."
msgstr "Não foi possível iniciar a entrada. Tente novamente."

msgctxt "AppWindow"
msgid "GameNode artwork: GPL-3.0-only · Roboto: SIL Open Font License 1.1 · Slint: GPLv3"
msgstr "Arte GameNode: GPL-3.0-only · Roboto: SIL Open Font License 1.1 · Slint: GPLv3"

