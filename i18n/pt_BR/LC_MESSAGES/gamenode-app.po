msgctxt "AppWindow"
msgid "Active renderer: Skia"
msgstr "Renderizador ativo: Skia"

msgctxt "AppWindow"
msgid "Active renderer: Software"
msgstr "Renderizador ativo: software"

msgctxt "AppWindow"
msgid "Active renderer: Software (automatic fallback)"
msgstr "Renderizador ativo: software (fallback automático)"

msgctxt "AppWindow"
msgid "GameNode could not initialize either renderer.\nSkia error: {gpu}\nSoftware error: {software}\nYour saved settings and session were preserved. Update your graphics driver or contact support with these details."
msgstr "O GameNode não conseguiu iniciar nenhum dos renderizadores.\nErro do Skia: {gpu}\nErro da renderização por software: {software}\nSuas configurações e sessão foram preservadas. Atualize o driver gráfico ou entre em contato com o suporte com estes detalhes."

msgctxt "AppWindow"
msgid "GameNode could not initialize software rendering.\nError: {software}\nYour saved settings and session were preserved. Update your graphics driver or contact support with these details."
msgstr "O GameNode não conseguiu iniciar a renderização por software.\nErro: {software}\nSuas configurações e sessão foram preservadas. Atualize o driver gráfico ou entre em contato com o suporte com estes detalhes."

msgctxt "AppWindow"
msgid "Skia failed to initialize: {gpu}\nGameNode could not restart with software rendering: {error}\nYour saved settings and session were preserved. Restart after updating your graphics driver."
msgstr "Falha ao iniciar o Skia: {gpu}\nO GameNode não conseguiu reiniciar com renderização por software: {error}\nSuas configurações e sessão foram preservadas. Reinicie após atualizar o driver gráfico."

